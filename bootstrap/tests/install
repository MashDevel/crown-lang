install_fixture() {
    fixture_number=$((fixture_number + 1))
    install_project="$scratch/install ' project $fixture_number"
    install_home="$scratch/install home $fixture_number"
    mkdir -p "$install_project/bootstrap" "$install_home"
    install_project=$(CDPATH= cd -- "$install_project" && pwd)
    cp "$root/bootstrap/install" "$install_project/bootstrap/install"
    printf '#!/bin/sh\nexit "${CROWN_TEST_FETCH_STATUS:-0}"\n' > "$install_project/bootstrap/fetch"
    printf '#!/bin/sh\nprintf "crown fixture\\n"\nexit "${CROWN_TEST_BUILD_STATUS:-0}"\n' > "$install_project/bootstrap/crown"
    chmod +x "$install_project/bootstrap/crown"
}
run_install() {
    env HOME="$install_home" ZDOTDIR= SHELL="$1" sh "$install_project/bootstrap/install"
}
install_zsh() {
    install_fixture
    printf 'export CROWN_TEST_PRESERVED=yes' > "$install_home/.zshrc"
    run_install /bin/zsh
    cp "$install_home/.zshrc" "$install_home/original"
    run_install /bin/zsh
    cmp "$install_home/.zshrc" "$install_home/original"
    env HOME="$install_home" PATH=/usr/bin:/bin sh -c '. "$HOME/.zshrc"; . "$HOME/.zshrc"; test "$CROWN_TEST_PRESERVED" = yes; test "$(crown --version)" = "crown fixture"; printf "%s\\n" "$PATH"' > "$install_home/path"
    test "$(cat "$install_home/path")" = "$install_project/bootstrap:/usr/bin:/bin"
    env HOME="$install_home" ZDOTDIR="$install_home/config" SHELL=/bin/zsh sh "$install_project/bootstrap/install"
    test -s "$install_home/config/.zshrc"
}
install_bash() {
    install_fixture
    printf 'export CROWN_TEST_PRESERVED=yes\n' > "$install_home/.profile"
    run_install /bin/bash
    test ! -e "$install_home/.bash_profile"
    for profile in .bashrc .profile; do
        env HOME="$install_home" PATH=/usr/bin:/bin bash --noprofile --norc -c '. "$HOME/$1"; . "$HOME/$1"; test "$(crown --version)" = "crown fixture"; printf "%s\\n" "$PATH"' bash "$profile" > "$install_home/path"
        test "$(cat "$install_home/path")" = "$install_project/bootstrap:/usr/bin:/bin"
    done
    cp "$install_home/.profile" "$install_home/original"
    run_install /bin/bash
    cmp "$install_home/.profile" "$install_home/original"
    install_fixture
    run_install /bin/bash
    test -s "$install_home/.bash_profile"
    install_fixture
    touch "$install_home/.bash_login"
    run_install /bin/bash
    test -s "$install_home/.bash_login"
    test ! -e "$install_home/.bash_profile"
}
install_failures() {
    install_fixture
    expect_failure run_install /bin/unsupported
    expect_failure env HOME="$install_home" SHELL=/bin/zsh sh "$install_project/bootstrap/install" --unknown
    expect_failure env HOME="$install_home" SHELL=/bin/zsh CROWN_TEST_FETCH_STATUS=1 sh "$install_project/bootstrap/install"
    expect_failure env HOME="$install_home" SHELL=/bin/zsh CROWN_TEST_BUILD_STATUS=1 sh "$install_project/bootstrap/install"
    test ! -e "$install_home/.zshrc"
    env HOME="$install_home" SHELL=/bin/unsupported sh "$install_project/bootstrap/install" --help
    test ! -e "$install_home/.zshrc"
    mv "$install_project" "$install_project:invalid"
    install_project="$install_project:invalid"
    expect_failure run_install /bin/zsh
    test ! -e "$install_home/.zshrc"
}
