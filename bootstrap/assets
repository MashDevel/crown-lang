#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$root/bootstrap/download"
asset_directory=${CROWN_BOOTSTRAP_ASSETS:-}
host=${1:-$(sh "$root/bootstrap/host")}
case "$host" in
    x86_64-macos|arm64-macos|x86_64-linux|arm64-linux) ;;
    *) printf '%s\n' 'error: unsupported bootstrap host' >&2; exit 1 ;;
esac
lock="$root/bootstrap/locks/$host.json"
release=$(cat "$root/bootstrap/seed-release")
case "$release" in
    ''|*[!a-zA-Z0-9._-]*) printf '%s\n' 'error: invalid bootstrap release tag' >&2; exit 1 ;;
esac
verify() {
    expected=$(awk -v field="$2" -f "$root/bootstrap/digest.awk" "$lock")
    actual=$(sh "$root/bootstrap/checksum" "$1")
    if [ "$actual" != "$expected" ]; then
        printf 'error: bootstrap checksum mismatch: %s\n' "$1" >&2
        return 1
    fi
}
download() {
    download_asset "$1" "$stage/$1"
}
prepare_download() {
    if [ -z "${CROWN_BOOTSTRAP_ASSETS:-}" ]; then
        repository=${CROWN_BOOTSTRAP_REPOSITORY:-$(cat "$root/bootstrap/repository")}
        validate_repository
    fi
    stage=$(mktemp -d "$root/bootstrap/download-XXXXXX")
    trap 'rm -rf "$stage"' EXIT HUP INT TERM
}
install_directory() {
    mkdir -p "$(dirname -- "$destination")"
    lock_directory="$destination.installing"
    if mkdir "$lock_directory" 2>/dev/null; then
        trap 'rmdir "$lock_directory"; rm -rf "$stage"' EXIT HUP INT TERM
        if [ -e "$destination" ]; then
            existing
        else
            mv "$stage/$1" "$destination"
        fi
    else
        printf '%s\n' 'error: another bootstrap installation is running; retry when it finishes' >&2
        exit 1
    fi
}
