#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$root/bootstrap/download"
host=$(sh "$root/bootstrap/host")
repository=${CROWN_RELEASE_REPOSITORY:-$(cat "$root/bootstrap/repository")}
asset_directory=${CROWN_RELEASE_ASSETS:-}
validate_repository
release=${CROWN_RELEASE:-}
if [ -z "$release" ]; then
    if [ -n "$asset_directory" ]; then
        printf '%s\n' 'error: CROWN_RELEASE is required with offline release assets' >&2
        exit 1
    fi
    release=$(latest_release)
fi
validate_release
prefix=${CROWN_INSTALL_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/crown}
case "$prefix" in
    *:*|*'
'*) printf '%s\n' 'error: the installation path cannot contain a colon or newline' >&2; exit 1 ;;
esac
mkdir -p "$prefix"
prefix=$(CDPATH= cd -- "$prefix" && pwd)
destination="$prefix/releases/$release/$host"
archive="crown-$host.tar.gz"
stage=$(mktemp -d "$root/bootstrap/release-XXXXXX")
trap 'rm -rf "$stage"' EXIT HUP INT TERM
download_asset SHA256SUMS "$stage/SHA256SUMS"
expected=$(awk -v name="$archive" '$2 == name { count++; value = $1 } END { if (count != 1 || length(value) != 64 || value ~ /[^0-9a-f]/) exit 1; print value }' "$stage/SHA256SUMS")
if [ -d "$destination" ]; then
    test "$(cat "$destination/.archive-sha256")" = "$expected"
    test -x "$destination/crown"
    test "$(sh "$root/bootstrap/checksum" "$destination/crown")" = "$(cat "$destination/.compiler-sha256")"
    test -d "$destination/components/library/src"
    printf '%s\n' "$destination"
    exit 0
fi
download_asset "$archive" "$stage/$archive"
actual=$(sh "$root/bootstrap/checksum" "$stage/$archive")
if [ "$actual" != "$expected" ]; then
    printf '%s\n' 'error: release archive checksum mismatch' >&2
    exit 1
fi
tar -tzf "$stage/$archive" > "$stage/members"
awk -v prefix="crown-$host/" 'index($0, prefix) != 1 || $0 ~ /(^|\/)\.\.(\/|$)/ { exit 1 }' "$stage/members"
mkdir "$stage/extracted"
tar -xzf "$stage/$archive" -C "$stage/extracted"
package="$stage/extracted/crown-$host"
test -x "$package/crown"
test -d "$package/components/library/src"
test -s "$package/REVISION"
printf '%s\n' "$expected" > "$package/.archive-sha256"
sh "$root/bootstrap/checksum" "$package/crown" > "$package/.compiler-sha256"
mkdir -p "$(dirname -- "$destination")"
mkdir "$destination.installing"
trap 'rmdir "$destination.installing"; rm -rf "$stage"' EXIT HUP INT TERM
test ! -e "$destination"
mv "$package" "$destination"
printf '%s\n' "$destination"
