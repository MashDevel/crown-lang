fn main(arguments: Arguments) -> u32 {
    let values = toolchain::arguments(arguments)
    if values.length() < 2 || values.length() > 3 {
        toolchain::failure("usage: unicode-tables INPUT_DIRECTORY [OUTPUT_DIRECTORY]")
        return 2
    }
    match generate(values) {
        Ok(done) => {
            done;
            return 0
        }
        Err(error) => {
            toolchain::failure(error);
            return 1
        }
    }
}

fn generate(values: Vec<Text>) -> Result<void, Text> {
    let output = if values.length() == 3 {
        values[2].clone()
    } else {
        toolchain::path_join(toolchain::repository_root()?, "components/library/src/unicode/generated")
    }
    return unicode_tables::generate(values[1], output)
}
