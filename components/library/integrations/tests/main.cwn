fn main() -> u32 {
    let identity = test_game_identity()
    if identity != 0 {
        return identity
    }
    let formats = test_audio_formats()
    if formats != 0 {
        return formats
    }
    let buffers = test_audio_buffers()
    if buffers != 0 {
        return buffers
    }
    return loop_test::run()
}
