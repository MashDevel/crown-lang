module std {
    module io {
        extern "c" {
            fn raw_read(data: RawPtr<u8>, size: usize, count: usize, file: RawPtr<u8>) -> usize = "fread"
            fn raw_write(data: RawPtr<u8>, size: usize, count: usize, file: RawPtr<u8>) -> usize = "fwrite"
            fn raw_close(file: RawPtr<u8>) -> i32 = "fclose"
        }

        copy enum Error {
            InvalidPath, Open, Seek, Read, Write, Close
        }
        copy enum Mode {
            Read, Write
        }

        opaque resource File {
            private handle: RawPtr<u8>
            drop {
                if handle != null() {
                    unsafe {
                        raw_close(handle)
                    }
                }
            }
        }

        fn null() -> RawPtr<u8> {
            unsafe {
                return RawPtr<u8>.from_address(0)
            }
        }

        fn open(path: TextView, mode: Mode) -> Result<File, Error> {
            let handle = open_handle(path, mode)?
            unsafe {
                if handle == null() {
                    return Err(Open())
                }
                return Ok(File {
                        handle: handle
                    })
            }
        }

        fn mode_text(mode: Mode) -> Text {
            return match mode {
                Read => "rb"
                Write => "wb"
            }
        }

        fn close(file: write File) -> Result<void, Error> {
            unsafe {
                if file.handle == null() {
                    return Err(Close())
                }
                let status = raw_close(file.handle)
                file.handle = null()
                if status != 0 {
                    return Err(Close())
                }
            }
            return Ok(())
        }

        fn size(file: write File) -> Result<usize, Error> {
            unsafe {
                if file.handle == null() {
                    return Err(Seek())
                }
                if raw_seek(file.handle, 0, 2) != 0 {
                    return Err(Seek())
                }
                let length = raw_tell(file.handle)
                if length < 0 || raw_seek(file.handle, 0, 0) != 0 {
                    return Err(Seek())
                }
                return Ok(usize.from(length))
            }
        }

        fn read_file(path: TextView) -> Result<Vec<u8>, Error> {
            var file = open(path, Mode::Read())?
            let length = size(file)?
            var output = bytes::filled(length, 0)
            read_exact(file, output)?
            close(file)?
            return Ok(move output)
        }

        fn read_exact(file: write File, output: write Vec<u8>) -> Result<void, Error> {
            unsafe {
                if file.handle == null() {
                    return Err(Error::Read())
                }
            }
            var offset: usize = 0
            while offset < output.length() {
                var count: usize = 0
                unsafe {
                    count = raw_read(output.as_raw().offset(offset), 1, output.length() - offset, file.handle)
                }
                if count == 0 {
                    return Err(Error::Read())
                }
                offset = offset + count
            }
            return Ok(())
        }

        fn write_file(path: TextView, input: Vec<u8>) -> Result<void, Error> {
            var file = open(path, Mode::Write())?
            write_all(file, input)?
            return close(file)
        }

        fn write_text(path: TextView, input: Text) -> Result<void, Error> {
            var file = open(path, Mode::Write())?
            unsafe {
                write_pointer(file, input.as_raw(), input.length())?
            }
            return close(file)
        }

        fn write_all(file: write File, input: Vec<u8>) -> Result<void, Error> {
            unsafe {
                return write_pointer(file, input.as_raw(), input.length())
            }
        }

        unsafe fn write_pointer(file: write File, input: RawPtr<u8>, length: usize) -> Result<void, Error> {
            unsafe {
                if file.handle == null() {
                    return Err(Error::Write())
                }
            }
            var offset: usize = 0
            while offset < length {
                var count: usize = 0
                unsafe {
                    count = raw_write(input.offset(offset), 1, length - offset, file.handle)
                }
                if count == 0 {
                    return Err(Error::Write())
                }
                offset = offset + count
            }
            return Ok(())
        }

        fn error_message(error: Error) -> Text {
            match error {
                InvalidPath => {
                    return "path contains a NUL byte"
                }
                Open => {
                    return "could not open file"
                }
                Seek => {
                    return "could not determine file length or seek"
                }
                Read => {
                    return "could not read the complete file"
                }
                Write => {
                    return "could not write the complete file"
                }
                Close => {
                    return "could not close file"
                }
            }
        }
    }
}
