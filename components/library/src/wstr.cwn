module std::wstr {
    opaque resource WString {
        private units: Vec<u16>
        drop {
        }
    }

    fn new(value: TextView) -> Option<WString> {
        for index in 0..value.length() {
            if value[index] == 0 {
                return None()
            }
        }
        var units = std::utf16::encode(value)
        units.push(0)
        unsafe {
            return Some(WString {
                    units: move units
                })
        }
    }

    fn length(value: WString) -> usize {
        unsafe {
            return value.units.length() - 1
        }
    }

    unsafe fn as_raw(value: WString) -> RawPtr<u16> {
        unsafe {
            return value.units.as_raw()
        }
    }
}
