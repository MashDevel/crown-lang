module native::pipewire {
    fn open() -> Result<std::dylib::Library, std::dylib::Error> {
        let names = std::text::split("pw_init|pw_main_loop_new|pw_main_loop_destroy|pw_main_loop_get_loop|pw_deinit|pw_properties_new_string|pw_properties_free|pw_stream_new_simple|pw_stream_connect|pw_stream_destroy|pw_stream_dequeue_buffer|pw_stream_queue_buffer|pw_stream_get_state", 124)
