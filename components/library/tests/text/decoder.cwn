fn test_decoded_characters() -> u32 {
    let valid: [u32; 10] = [0, 127, 128, 2047, 2048, 0xd7ff, 0xe000, 0xffff, 0x10000, 0x10ffff]
    for index in 0..10 {
        match std::text::decoded_character(valid[index], 0) {
            Ok(value) => {
                if value != char.from(valid[index]) {
                    return 1
                }
            }
            Err(error) => {
                error;
                return 2
            }
        }
    }
    let invalid: [u32; 3] = [0xd800, 0xdfff, 0x110000]
    for index in 0..3 {
        if decoded_character_rejected(invalid[index], 0) == false {
            return 3
        }
    }
    if decoded_character_rejected(127, 128) == false {
        return 4
    }
    return test_decoder_boundaries()
}

fn decoded_character_rejected(value: u32, minimum: u32) -> bool {
    match std::text::decoded_character(value, minimum) {
        Ok(character) => {
            character;
            return false
        }
        Err(error) => error == std::text::Utf8Error::Scalar()
    }
}

fn test_decoder_boundaries() -> u32 {
    let incomplete: [u8; 1] = [0xc2]
    var index: usize = 0
    match std::text::decode_scalar_checked(incomplete, index) {
        Ok(value) => {
            value;
            return 5
        }
        Err(error) => {
            if error != std::text::Utf8Error::Truncated() {
                return 6
            }
        }
    }
    if index != 1 {
        return 7
    }
    let complete: [u8; 4] = [0xf1, 0x80, 0x80, 0x80]
    index = 0
    match std::text::decode_scalar_checked(complete, index) {
        Ok(value) => {
            if value != char.from(0x40000) || index != 4 {
                return 8
            }
        }
        Err(error) => {
            error;
            return 9
        }
    }
    return 0
}
