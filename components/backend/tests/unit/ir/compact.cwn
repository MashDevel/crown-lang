fn compact_validate(function: ir::Function) -> Result<void, u32> {
    var program = ir::program_new()
    ir::program_add_function(program, ir::function_copy(function))
    match ir::validate_program(program) {
        Ok(value) => {
            value;
            return Ok(())
        }
        Err(error) => {
            error;
            return Err(1)
        }
    }
}

fn compact_fixture() -> Result<ir::Function, u32> {
    var parameters = Vec<ir::Type>.new()
    parameters.push(ir::TypePointer())
    parameters.push(ir::TypePointer())
    let integer = ir::TypeInteger(ir::IntegerWidth32())
    var function = ir::function_new("compact", ir::signature_new(move parameters, integer), ir::LinkageLocal())
    ir::function_new_value(function, integer)
    let parameter = ir::function_new_value(function, ir::TypePointer())
    function.parameters[0] = parameter
    function.exclusive_parameters.push(parameter)
    let first = safety_integer(function, ir::IntegerWidth32(), 20)
    let second = safety_integer(function, ir::IntegerWidth32(), 22)
    safety_block(function)?
    let result = safety_append(function, 0, ir::InstructionBinary(ir::BinaryAdd(), first, second))?
    safety_terminate(function, 0, ir::TerminatorReturn(Some(result)))?
    safety_integer(function, ir::IntegerWidth32(), 99)
    return Ok(move function)
}

fn compact_metadata(function: ir::Function) -> Result<void, u32> {
    safety_require(function.values.length() == 5, 2)?
    safety_require(function.parameters[0] == 1 && function.parameters[1] == 0, 3)?
    safety_require(function.exclusive_parameters[0] == 1, 4)?
    return compact_constant_metadata(function)
}

fn compact_constant_metadata(function: ir::Function) -> Result<void, u32> {
    safety_require(function.constants.length() == 2 && function.constant_indices.length() == 5, 5)?
    safety_require(function.constants[0].id == 2 && function.constants[1].id == 3, 6)?
    return safety_require(function.constant_indices[2] == 0 && function.constant_indices[3] == 1, 7)
}

fn compact_operands(function: ir::Function) -> Result<void, u32> {
    let operands = ir::instruction_operands(function.blocks[0].instructions[0].kind)
    safety_require(operands[0] == 2 && operands[1] == 3, 8)?
    match function.blocks[0].instructions[0].result {
        Some(value) => safety_require(value == 4, 9)?,
        None => {
            return Err(10)
        }
    }
    match read function.blocks[0].terminator {
        Some(terminator) => {
            let values = ir::terminator_operands(terminator)
            return safety_require(values.length() == 1 && values[0] == 4, 11)
        }
        None => Err(12)
    }
}

fn compact_values() -> Result<void, u32> {
    var function = compact_fixture()?
    compact_validate(function)?
    safety_require(ir::function_compact_values(function) == 3, 13)?
    compact_metadata(function)?
    compact_operands(function)?
    compact_validate(function)?
    return safety_require(ir::function_compact_values(function) == 0, 14)
}

fn compact_phi_fixture() -> Result<ir::Function, u32> {
    let integer = ir::TypeInteger(ir::IntegerWidth32())
    var function = ir::function_new("phi", ir::signature_new(Vec<ir::Type>.new(), integer), ir::LinkageLocal())
    ir::function_new_value(function, integer)
    let condition = safety_integer(function, ir::IntegerWidth1(), 1)
    let first = safety_integer(function, ir::IntegerWidth32(), 20)
    let second = safety_integer(function, ir::IntegerWidth32(), 22)
    for block in 0..4 {
        block;
        safety_block(function)?
    }
    safety_terminate(function, 0, ir::TerminatorConditional(condition, 1, 2))?
    safety_terminate(function, 1, ir::TerminatorBranch(3))?
    safety_terminate(function, 2, ir::TerminatorBranch(3))?
    var incoming = Vec<ir::PhiIncoming>.new()
    incoming.push(ir::PhiIncoming {
            block: 1, value: first
        })
    incoming.push(ir::PhiIncoming {
            block: 2, value: second
        })
    let value = safety_append(function, 3, ir::InstructionPhi(integer, move incoming))?
    safety_terminate(function, 3, ir::TerminatorReturn(Some(value)))?
    return Ok(move function)
}

fn compact_phis() -> Result<void, u32> {
    var function = compact_phi_fixture()?
    compact_validate(function)?
    safety_require(ir::function_compact_values(function) == 1, 15)?
    compact_validate(function)?
    let operands = ir::instruction_operands(function.blocks[3].instructions[0].kind)
    safety_require(operands[0] == 1 && operands[1] == 2, 16)?
    let branch = ir::block_conditional(function.blocks[0])
    match branch {
        Some(value) => safety_require(value.condition == 0 && value.then_block == 1 && value.else_block == 2, 17),
        None => Err(18)
    }
}

fn compact_cases() -> Result<void, u32> {
    var empty = ir::function_new("empty", ir::signature_new(Vec<ir::Type>.new(), ir::TypeVoid()), ir::LinkageImport())
    safety_require(ir::function_compact_values(empty) == 0, 19)?
    compact_values()?
    return compact_phis()
}

fn main() -> u32 {
    return safety_status(compact_cases())
}
