fn main() -> u32 {
    var parameters = Vec<ir::Type>.new()
    let result_type = ir::TypeInteger(ir::IntegerWidth32())
    let signature = ir::signature_new(move parameters, result_type)
    var function = ir::function_new("answer", move signature, ir::LinkageLocal())
    var block: usize = 0
    match ir::function_add_block(function) {
        Ok(value) => {
            block = value
        }
        Err(error) => {
            error;
            return 1
        }
    }
    let constant_type = ir::TypeInteger(ir::IntegerWidth32())
    let answer: u64 = 42
    let constant_value = ir::ConstantInteger(answer)
    let value = ir::function_constant(function, constant_type, constant_value)
    match ir::function_terminate(function, block, ir::TerminatorReturn(Some(value))) {
        Ok(item) => {
            item
        }
        Err(error) => {
            error;
            return 2
        }
    }
    var program = ir::program_new()
    let function_id = ir::program_add_function(program, move function)
    ir::program_set_entry(program, function_id)
    match ir::validate_program(program) {
        Ok(item) => {
            item;
            return 42
        }
        Err(error) => {
            error;
            return 3
        }
    }
}
