fn windows_capture_callee() -> Result<ir::Function, u32> {
    let value_type = ir::TypeInteger(ir::IntegerWidth64())
    var parameters = Vec<ir::Type>.new()
    for index in 0..12 {
        index;
        parameters.push(value_type)
    }
    parameters.push(ir::TypePointer())
    var signature = ir::signature_new(move parameters, value_type)
    signature.parameter_abi[12] = ir::ParameterAggregate(ir::AggregateMemory(16, 8))
    var function = ir::function_new("windows_capture", move signature, ir::LinkageLocal())
    let block = safety_block(function)?
    var sum = safety_append(function, block, ir::InstructionLoad(12, value_type, 8, false))?
    for index in 0..12 {
        sum = safety_append(function, block, ir::InstructionBinary(ir::BinaryAdd(), sum, function.parameters[index]))?
    }
    safety_terminate(function, block, ir::TerminatorReturn(Some(sum)))?
    return Ok(move function)
}

fn windows_capture_caller(target: usize) -> Result<ir::Function, u32> {
    let value_type = ir::TypeInteger(ir::IntegerWidth64())
    var function = ir::function_new("windows_capture_entry", ir::signature_new(Vec<ir::Type>.new(), ir::TypeInteger(ir::IntegerWidth32())), ir::LinkageExport())
    let block = safety_block(function)?
    var arguments = Vec<usize>.new()
    for index in 0..12 {
        arguments.push(safety_integer(function, ir::IntegerWidth64(), u64.from(index + 1)))
    }
    let input = safety_append(function, block, ir::InstructionStackSlot(16, 8))?
    let value = safety_integer(function, ir::IntegerWidth64(), 42)
    safety_append(function, block, ir::InstructionStore(input, value, 8, false))?
    arguments.push(input)
    let result = safety_append(function, block, ir::InstructionCall(target, move arguments, value_type))?
    let expected = safety_integer(function, ir::IntegerWidth64(), 120)
    safety_return_equal(function, block, result, expected)?
    return Ok(move function)
}

fn windows_capture_program() -> Result<ir::Program, u32> {
    var program = ir::program_new()
    let target = ir::program_add_function(program, windows_capture_callee()?)
    program.entry = Some(ir::program_add_function(program, windows_capture_caller(target)?))
    return Ok(move program)
}
