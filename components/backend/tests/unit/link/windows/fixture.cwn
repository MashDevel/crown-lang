fn fixture(architecture: object::Architecture) -> object::CompilerObject {
    var output = object::new()
    output.architecture = architecture
    var bytes = Vec<u8>.new()
    if architecture == object::ArchitectureArm64() {
        link_binary::pad(bytes, 8)
        link_binary::put(bytes, 0, 3531605312, 4)
        link_binary::put(bytes, 4, 3596551104, 4)
    } else {
        bytes.push(184)
        bytes.push(42)
        bytes.push(0)
        bytes.push(0)
        bytes.push(0)
        bytes.push(195)
    }
    let size = u64.from(bytes.length())
    output.sections.push(object::Section {
            name: ".text", kind: object::SectionText(), alignment: 16, data: move bytes, memory_size: size
        })
    output.symbols.push(object::Symbol {
            name: "main", kind: object::SymbolFunction(), binding: object::SymbolGlobal(), section: Some(0), offset: 0, size: size
        })
    output.entry = Some(0)
    return move output
}

fn import_fixture(architecture: object::Architecture) -> object::CompilerObject {
    var output = fixture(architecture)
    output.symbols.push(object::Symbol {
            name: "ExitProcess", kind: object::SymbolFunction(), binding: object::SymbolImport(), section: None(), offset: 0, size: 0
        })
    return move output
}
