fn load_command(bytes: Vec<u8>, kind: u64) -> Result<usize, Text> {
    let count = usize.from(link_binary::number(bytes, 16, 4)?)
    var offset: usize = 32
    for index in 0..count {
        index;
        if link_binary::number(bytes, offset, 4)? == kind {
            return Ok(offset)
        }
        offset = offset + usize.from(link_binary::number(bytes, offset + 4, 4)?)
    }
    return Err("expected Mach-O load command")
}
fn verify_image(object: take object::CompilerObject) -> Result<void, Text> {
    let bytes = macho::executable(object, macho::libraries(Vec<Text>.new())?)?
    verify_headers(bytes)?
    verify_signature_extent(bytes)?
    if toolchain::host_target().architecture == toolchain::Architecture::Arm64() {
        execute_image(bytes)?
    }
    return Ok(())
}
fn verify_headers(bytes: Vec<u8>) -> Result<void, Text> {
    testing::expect(link_binary::number(bytes, 4, 4)? == 16777228, "ARM64 executable CPU")?
    let main = load_command(bytes, 2147483688)?
    return testing::expect(link_binary::number(bytes, main + 8, 8)? >= 16384, "ARM64 header page")
}
fn verify_signature_extent(bytes: Vec<u8>) -> Result<void, Text> {
    let signature = load_command(bytes, 29)?
    let start = usize.from(link_binary::number(bytes, signature + 8, 4)?)
    let size = usize.from(link_binary::number(bytes, signature + 12, 4)?)
    return testing::expect(start + size == bytes.length(), "code signature ends at EOF")
}
fn execute_image(bytes: Vec<u8>) -> Result<void, Text> {
    let temporary = toolchain::temporary(toolchain::temporary_directory())?
    let directory = toolchain::temporary_path(temporary)
    let path = toolchain::path_join(directory, "program")
    toolchain::write_bytes(path, bytes)?
    toolchain::executable(path)?
    var arguments = Vec<Text>.new()
    arguments.push(path.clone())
    let result = toolchain::capture(toolchain::command(move arguments), directory)?
    return testing::expect(result.status == 42 && result.stdout.length() == 0 && result.stderr.length() == 0, "native ARM64 Mach-O execution")
}
fn run() -> Result<void, Text> {
    verify_image(arm_macho_fixture()?)?
    verify_image(arm_macho_import()?)?
    verify_image(arm_macho_address()?)?
    var missing = arm_macho_import()?
    let index = match link_object::existing_symbol(missing, "exit") {
        Some(value) => value,
        None => {
            return Err("missing fixture import")
        }
    }
    missing.symbols[index].name = "crown_missing_arm64_import"
    return testing::error(macho::executable(missing, macho::libraries(Vec<Text>.new())?))
}
fn main() -> u32 {
    match run() {
        Ok(value) => {
            value;
            42
        },
        Err(error) => {
            toolchain::failure(error);
            1
        }
    }
}
