fn main() -> u32 {
    var bytes = Vec<u8>.new()
    let byte_load = x86::LoadIndexed(x86::LoadIndexedArgs {
            destination: x86::R13(), base: x86::Rsi(), index: x86::R12(), scale: 1, width: x86::Byte(), extension: x86::ZeroExtend()
        })
    let word_load = x86::LoadIndexed(x86::LoadIndexedArgs {
            destination: x86::R8(), base: x86::R9(), index: x86::Rsp(), scale: 1, width: x86::Word(), extension: x86::SignExtend()
        })
    if x86::encode_fixed(byte_load, bytes) == false {
        return 1
    }
    if x86::encode_fixed(word_load, bytes) == false {
        return 2
    }
    let expected: [u8; 10] = [77, 15, 182, 44, 52, 78, 15, 191, 4, 12]
    loan read expected as values {
        if test_bytes_equal(bytes, values) == false {
            return 3
        }
    }
    return 42
}
