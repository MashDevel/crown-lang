fn parameter_case(exclusive: bool) -> Result<void, u32> {
    var parameters = Vec<ir::Type>.new()
    parameters.push(ir::TypePointer())
    parameters.push(ir::TypePointer())
    var function = ir::function_new("parameters", ir::signature_new(move parameters, ir::TypeVoid()), ir::LinkageLocal())
    safety_block(function)?
    if exclusive {
        function.exclusive_parameters.push(1)
    }
    safety_load_store_load(function, 0, 1, false)?
    safety_terminate(function, 0, ir::TerminatorReturn(None()))?
    var copied = ir::function_copy(function)
    safety_require(ir::exclusive_parameters_valid(copied), 1)?
    let expected: usize = if exclusive {
        1
    } else {
        0
    }
    safety_require(optimize::load(copied) == expected, 2)?
    copied.exclusive_parameters.push(999)
    safety_require(ir::exclusive_parameters_valid(copied) == false, 3)?
    return Ok(())
}

fn parameters() -> Result<void, u32> {
    parameter_case(false)?
    parameter_case(true)?
    return Ok(())
}

fn main() -> u32 {
    return safety_status(parameters())
}
