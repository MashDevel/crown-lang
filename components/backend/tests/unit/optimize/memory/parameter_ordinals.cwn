fn reordered_writer() -> Result<ir::Function, u32> {
    var parameters = Vec<ir::Type>.new()
    parameters.push(ir::TypePointer());
    parameters.push(ir::TypePointer())
    var function = ir::function_new("writer", ir::signature_new(move parameters, ir::TypeVoid()), ir::LinkageLocal())
    function.parameters[0] = 1;
    function.parameters[1] = 0
    safety_block(function)?
    let value = safety_integer(function, ir::IntegerWidth64(), 9)
    safety_append(function, 0, ir::InstructionStore(0, value, 8, false))?
    safety_terminate(function, 0, ir::TerminatorReturn(None()))?
    return Ok(move function)
}

fn reordered_caller() -> Result<ir::Function, u32> {
    var function = ir::function_new("safety_entry", ir::signature_new(Vec<ir::Type>.new(), ir::TypeInteger(ir::IntegerWidth32())), ir::LinkageLocal())
    safety_block(function)?
    let first = safety_append(function, 0, ir::InstructionStackSlot(8, 8))?
    let second = safety_append(function, 0, ir::InstructionStackSlot(8, 8))?
    let initial = safety_integer(function, ir::IntegerWidth64(), 1)
    safety_append(function, 0, ir::InstructionStore(second, initial, 8, false))?
    reordered_reads(function, first, second)?
    return Ok(move function)
}

fn reordered_reads(function: write ir::Function, first: usize, second: usize) -> Result<void, u32> {
    let integer = ir::TypeInteger(ir::IntegerWidth64())
    safety_append(function, 0, ir::InstructionLoad(second, integer, 8, false))?
    var arguments = Vec<usize>.new();
    arguments.push(first);
    arguments.push(second)
    safety_append(function, 0, ir::InstructionCall(0, move arguments, ir::TypeVoid()))?
    let loaded = safety_append(function, 0, ir::InstructionLoad(second, integer, 8, false))?
    let expected = safety_integer(function, ir::IntegerWidth64(), 9)
    return safety_return_equal(function, 0, loaded, expected)
}

fn reordered_effects() -> Result<void, u32> {
    var program = ir::program_new()
    ir::program_add_function(program, reordered_writer()?)
    ir::program_add_function(program, reordered_caller()?)
    ir::program_set_entry(program, 1)
    match ir::validate_program(program) {
        Ok(value) => {
            value;
        }
        Err(error) => {
            error;
            return Err(1)
        }
    }
    let effects = optimize::memory_effects(program)
    safety_require(optimize::load_with_effects(program.functions[1], effects) == 0, 2)?
    return safety_execute(move program)
}

fn main() -> u32 {
    return safety_status(reordered_effects())
}
