fn add_block(function: write ir::Function) -> Result<void, u32> {
    match ir::function_add_block(function) {
        Ok(block) => {
            block
            return Ok(())
        }
        Err(error) => {
            error
            return Err(1)
        }
    }
}

fn terminate(function: write ir::Function, block: usize, target: usize) -> Result<void, u32> {
    match ir::function_terminate(function, block, ir::TerminatorBranch(target)) {
        Ok(value) => {
            value
            return Ok(())
        }
        Err(error) => {
            error
            return Err(2)
        }
    }
}

fn add_phi(function: write ir::Function, block: usize, source: usize, integer: ir::Type) -> Result<void, u32> {
    var incoming = Vec<ir::PhiIncoming>.new()
    incoming.push(ir::PhiIncoming {
            block: source, value: function.parameters[0]
        })
    match ir::function_append(function, block, ir::InstructionPhi(integer, move incoming)) {
        Ok(value) => {
            value
            return Ok(())
        }
        Err(error) => {
            error
            return Err(3)
        }
    }
}

fn phi_source(function: ir::Function, block: usize) -> usize {
    match read function.blocks[block].instructions[0].kind {
        ir::InstructionPhi(value_type, incoming) => {
            value_type
            return incoming[0].block
        }
        _ => 99
    }
}

fn expect_sources(function: ir::Function, first: usize, second: usize, error: u32) -> Result<void, u32> {
    if phi_source(function, 2) != first || phi_source(function, 3) != second {
        return Err(error)
    }
    return Ok(())
}

fn expect_no_call(function: ir::Function, block: usize, instruction: usize, error: u32) -> Result<void, u32> {
    let site = optimize::InlineSite {
        block: block, instruction: instruction, callee: 0, cost: 0
    }
    match optimize::inline_call_parts(function, site) {
        None() => Ok(())
        Some(call) => {
            call
            Err(error)
        }
    }
}

fn source_function() -> Result<ir::Function, u32> {
    let integer = ir::TypeInteger(ir::IntegerWidth64())
    var parameters = Vec<ir::Type>.new()
    parameters.push(integer)
    var function = ir::function_new("phi", ir::signature_new(move parameters, ir::TypeVoid()), ir::LinkageLocal())
    for index in 0..5 {
        index
        add_block(function)?
    }
    terminate(function, 1, 2)?
    terminate(function, 4, 3)?
    add_phi(function, 2, 0, integer)?
    add_phi(function, 3, 4, integer)?
    return Ok(move function)
}

fn check_sources() -> Result<void, u32> {
    var function = source_function()?
    expect_no_call(function, 5, 0, 6)?
    expect_no_call(function, 2, 1, 7)?
    expect_no_call(function, 2, 0, 8)?
    optimize::replace_inline_phi_source(function, 0, 0)
    expect_sources(function, 0, 4, 9)?
    optimize::replace_inline_phi_source(function, 0, 1)
    expect_sources(function, 1, 4, 4)?
    optimize::replace_inline_phi_source(function, 1, 3)
    expect_sources(function, 1, 4, 5)?
    return Ok(())
}

fn main() -> u32 {
    match check_sources() {
        Ok(value) => {
            value
            return 42
        }
        Err(error) => error
    }
}
