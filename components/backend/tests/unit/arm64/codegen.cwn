fn arm_fixture() -> Result<ir::Program, u32> {
    var function = ir::function_new("answer", ir::signature_new(Vec<ir::Type>.new(), ir::TypeInteger(ir::IntegerWidth32())), ir::LinkageExport())
    let block = safety_block(function)?
    let value = ir::function_constant(function, ir::TypeInteger(ir::IntegerWidth32()), ir::ConstantInteger(42))
    safety_terminate(function, block, ir::TerminatorReturn(Some(value)))?
    var program = ir::program_new()
    ir::program_add_function(program, move function)
    return Ok(move program)
}

fn arm_codegen_validates() -> Result<void, u32> {
    let object = match arm64::codegen(arm_fixture()?, safety_arm_variant()) {
        Ok(value) => move value
        Err(error) => {
            toolchain::failure(error);
            return Err(1)
        }
    }
    safety_require(object.architecture == object::ArchitectureArm64(), 2)?
    safety_require(object.entry == Some(0), 3)?
    match object::validate(object) {
        Ok(value) => {
            value;
        }
        Err(error) => {
            error;
            return Err(4)
        }
    }
    if toolchain::host_target().architecture == toolchain::Architecture::Arm64() {
        let temporary = match toolchain::temporary(toolchain::temporary_directory()) {
            Ok(value) => move value
            Err(error) => {
                error;
                return Err(5)
            }
        }
        let path = toolchain::path_join(toolchain::temporary_path(temporary), "answer")
        let status = arm_run(move object, path)?
        return safety_require(status == 42, 6)
    }
    return Ok(())
}

fn arm_run(object: take object::CompilerObject, path: Text) -> Result<i32, u32> {
    let result = arm_run_checked(move object, path)
    return match move result {
        Ok(value) => Ok(value)
        Err(error) => {
            toolchain::failure(error);
            Err(7)
        }
    }
}

fn arm_run_checked(object: take object::CompilerObject, path: Text) -> Result<i32, Text> {
    let bytes = safety_executable(move object)?
    toolchain::write_bytes(path, bytes)?
    toolchain::executable(path)?
    var command = Vec<Text>.new()
    command.push(path.clone())
    return toolchain::execute(toolchain::command(move command))
}

fn arm_codegen_rejects() -> Result<void, u32> {
    var program = arm_fixture()?
    program.functions[0].blocks[0].terminator = None()
    match arm64::codegen(move program, safety_arm_variant()) {
        Err(error) => {
            error;
        }
        Ok(value) => {
            value;
            return Err(8)
        }
    }
    match arm64::codegen(ir::program_new(), arm64::AbiVariant::Aapcs64()) {
        Err(error) => {
            error;
        }
        Ok(value) => {
            value;
            return Err(9)
        }
    }
    return Ok(())
}

fn run() -> Result<void, u32> {
    arm_codegen_validates()?
    arm_codegen_rejects()?
    return arm_vector_opcodes()
}

fn arm_opcode(actual: take Result<u32, Text>, expected: u32, code: u32) -> Result<void, u32> {
    return match move actual {
        Ok(value) => safety_require(value == expected, code)
        Err(error) => {
            toolchain::failure(error);
            Err(code)
        }
    }
}

fn arm_opcode_error(actual: take Result<u32, Text>, code: u32) -> Result<void, u32> {
    return match move actual {
        Err(error) => {
            error;
            Ok(())
        }
        Ok(value) => {
            value;
            Err(code)
        }
    }
}

fn arm_vector_opcodes() -> Result<void, u32> {
    arm_vector_lanes()?
    arm_vector_integer_opcodes()?
    return arm_vector_float_opcodes()
}

fn arm_vector_lanes() -> Result<void, u32> {
    arm_opcode(arm64::vector_lane_size(1), 0, 10)?
    arm_opcode(arm64::vector_lane_size(2), 1, 11)?
    arm_opcode(arm64::vector_lane_size(4), 2, 12)?
    arm_opcode(arm64::vector_lane_size(8), 3, 13)?
    arm_opcode_error(arm64::vector_lane_size(0), 14)?
    return arm_opcode_error(arm64::vector_lane_size(16), 15)
}

fn arm_vector_integer_opcodes() -> Result<void, u32> {
    arm_opcode(arm64::vector_integer_opcode(ir::BinaryAdd(), 1), 1310753792, 16)?
    arm_opcode(arm64::vector_integer_opcode(ir::BinarySubtract(), 2), 1851819008, 17)?
    arm_opcode(arm64::vector_integer_opcode(ir::BinaryMultiply(), 4), 1319148544, 18)?
    arm_opcode(arm64::vector_integer_opcode(ir::BinaryAnd(), 8), 1310727168, 19)?
    arm_opcode(arm64::vector_integer_opcode(ir::BinaryOr(), 1), 1319115776, 20)?
    arm_opcode(arm64::vector_integer_opcode(ir::BinaryXor(), 1), 1847598080, 21)?
    arm_opcode_error(arm64::vector_integer_opcode(ir::BinaryFloatAdd(), 4), 22)?
    return arm_opcode_error(arm64::vector_integer_opcode(ir::BinaryAdd(), 16), 23)
}

fn arm_vector_float_opcodes() -> Result<void, u32> {
    arm_opcode(arm64::vector_float_opcode(ir::BinaryFloatAdd(), false), 1310774272, 24)?
    arm_opcode(arm64::vector_float_opcode(ir::BinaryFloatSubtract(), false), 1319162880, 25)?
    arm_opcode(arm64::vector_float_opcode(ir::BinaryFloatMultiply(), false), 1847647232, 26)?
    arm_opcode(arm64::vector_float_opcode(ir::BinaryFloatDivide(), false), 1847655424, 27)?
    arm_opcode(arm64::vector_float_opcode(ir::BinaryFloatAdd(), true), 1314968576, 28)?
    return arm_opcode_error(arm64::vector_float_opcode(ir::BinaryAdd(), false), 29)
}

fn main() -> u32 {
    return safety_status(run())
}
