fn function_fixture() -> ir::Function {
    let signature = ir::signature_new(Vec<ir::Type>.new(), ir::TypeInteger(ir::IntegerWidth64()))
    var function = ir::function_new("main", move signature, ir::LinkageExport())
    for index in 0..4 {
        index;
        function.values.push(ir::TypePointer())
    }
    var block = ir::basic_block_new()
    block.instructions.push(ir::Instruction {
            result: Some(2), kind: ir::InstructionStackSlot(24, 8)
        })
    block.instructions.push(ir::Instruction {
            result: Some(3), kind: ir::InstructionStackSlot(9, 64)
        })
    block.instructions.push(ir::Instruction {
            result: None(), kind: ir::InstructionStore(2, 3, 8, false)
        })
    function.blocks.push(move block)
    return move function
}

fn frame_layout() -> Result<void, Text> {
    let frame = arm64::frame_new(function_fixture())?
    testing::expect(frame.size == 160, "saved registers and aligned allocations fit the frame")?
    testing::expect(frame.allocations[2] == 16 && frame.allocations[3] == 64, "allocation alignment and padding")?
    testing::expect(arm64::frame_register(frame, 2) == 19 && arm64::frame_register(frame, 3) == 20, "live scalar pointers occupy distinct registers")?
    testing::error(arm64::frame_value(frame, 3))?
    testing::error(arm64::frame_copy(frame, 3))?
    return testing::error(arm64::frame_value(frame, 4))
}

fn frame_failures() -> Result<void, Text> {
    var frame = arm64::frame_new(function_fixture())?
    testing::error(arm64::frame_reserve(frame, 1, 3))?
    testing::error(arm64::frame_reserve(frame, 1, 0))?
    testing::error(arm64::frame_reserve(frame, arm64::FRAME_LIMIT, 16))?
    testing::error(arm64::frame_reserve(frame, 18446744073709551615, 64))?
    return testing::expect(frame.size == 160, "invalid reservations preserve the frame")
}

fn mixed_frame_layout() -> Result<void, Text> {
    var function = ir::function_new("mixed", ir::signature_new(Vec<ir::Type>.new(), ir::TypeVoid()), ir::LinkageLocal())
    let types: [ir::Type; 4] = [ir::TypeInteger(ir::IntegerWidth8()), ir::TypeInteger(ir::IntegerWidth128()), ir::TypeFloat(ir::FloatWidth32()), ir::TypeVector(ir::VectorInteger(ir::IntegerWidth32()))]
    var block = ir::basic_block_new()
    for index in 0..4 {
        function.values.push(types[index])
        block.instructions.push(ir::Instruction {
                result: Some(index), kind: ir::InstructionPhi(types[index], Vec<ir::PhiIncoming>.new())
            })
    }
    function.blocks.push(move block)
    let frame = arm64::frame_new(function)?
    let offsets: [u64; 4] = [0, 16, 32, 48]
    for index in 0..4 {
        testing::expect(arm64::frame_value(frame, index)? == offsets[index], "wide values retain sixteen-byte alignment")?
        testing::expect(arm64::frame_copy(frame, index)? == 64 + offsets[index], "each phi retains a separate correctly sized staging slot")?
    }
    testing::expect(frame.size == 128, "mixed scalar and wide frame size")?
    return testing::error(arm64::frame_copy(frame, 4))
}

fn frame_instruction_failures() -> Result<void, Text> {
    var frame = arm64::frame_new(function_fixture())?
    testing::error(arm64::frame_result(frame, None()))?
    testing::error(arm64::frame_result(frame, Some(4)))?
    testing::error(arm64::frame_value_size(ir::TypeVoid()))?
    testing::error(arm64::frame_value_size(ir::TypeAggregate(32, 8)))?
    let instruction = ir::Instruction {
        result: None(), kind: ir::InstructionPhi(ir::TypePointer(), Vec<ir::PhiIncoming>.new())
    }
    testing::error(arm64::frame_instruction(frame, instruction))?
    return testing::expect(frame.size == 160, "invalid phi leaves the frame unchanged")
}

fn constant_frame_values() -> Result<void, Text> {
    var function = ir::function_new("constants", ir::signature_new(Vec<ir::Type>.new(), ir::TypeVoid()), ir::LinkageLocal())
    let narrow = ir::function_constant(function, ir::TypeInteger(ir::IntegerWidth8()), ir::ConstantInteger(257))
    let wide = ir::function_constant(function, ir::TypeInteger(ir::IntegerWidth128()), ir::ConstantWideInteger(ir::WideInteger {
                low: 3, high: 7
            }))
    ir::function_constant(function, ir::TypeFloat(ir::FloatWidth32()), ir::ConstantFloat32(1065353216))
    ir::function_constant(function, ir::TypeFloat(ir::FloatWidth64()), ir::ConstantFloat64(4607182418800017408))
    ir::function_constant(function, ir::TypePointer(), ir::ConstantNull())
    let frame = arm64::frame_new(function)?
    testing::expect(frame.size == 0, "constants are materialized where used without stack slots")?
    testing::error(arm64::frame_value(frame, narrow))?
    var compiler = arm64::compiler_new(function, arm64::AbiVariant::Darwin())?
    arm64::value_load(compiler, narrow, 9)
    arm64::value_load(compiler, wide, 10)
    arm64::value_high(compiler, wide, 11)
    arm64::finish_encoding(compiler)?
    return constant_frame_encoding(compiler)
}

fn constant_frame_encoding(compiler: arm64::Compiler) -> Result<void, Text> {
    testing::expect(compiler.bytes.length() == 12, "small constants each materialize in one instruction")?
    testing::expect(link_binary::number(compiler.bytes, 0, 4)? == u64.from(arm64::move_wide(9, 1, 0, false)?), "narrow constants remain normalized")?
    testing::expect(link_binary::number(compiler.bytes, 4, 4)? == u64.from(arm64::move_wide(10, 3, 0, false)?), "wide low constant bits")?
    return testing::expect(link_binary::number(compiler.bytes, 8, 4)? == u64.from(arm64::move_wide(11, 7, 0, false)?), "wide high constant bits")
}

fn stack_encoding() -> Result<void, Text> {
    var bytes = Vec<u8>.new()
    arm64::emit_stack_adjust(bytes, 0, false)?
    testing::expect(bytes.length() == 0, "empty stack adjustment")?
    arm64::emit_stack_adjust(bytes, 4096, true)?
    let expected = arm64::add_immediate(31, 31, 1, true)? | 4194304
    testing::expect(bytes.length() == 4 && link_binary::number(bytes, 0, 4)? == u64.from(expected), "large frame uses a shifted immediate")?
    testing::error(arm64::emit_stack_adjust(bytes, 1, false))?
    testing::error(arm64::emit_stack_adjust(bytes, arm64::FRAME_LIMIT + 16, false))?
    return testing::error(arm64::emit_frame_access(bytes, 17, 0, 8, true))
}

fn frame_object() -> Result<object::CompilerObject, Text> {
    let frame = arm64::frame_new(function_fixture())?
    var bytes = Vec<u8>.new()
    arm64::emit_prologue(bytes, frame)?
    arm64::emit_immediate(bytes, 9, 42)?
    arm64::emit_frame_access(bytes, 9, arm64::frame_value(frame, 0)?, 8, false)?
    arm64::emit_frame_access(bytes, 0, arm64::frame_value(frame, 0)?, 8, true)?
    arm64::emit_epilogue(bytes, frame)?
    var object = object::new()
    object.architecture = object::ArchitectureArm64()
    let size = u64.from(bytes.length())
    object.sections.push(object::Section {
            name: "text", kind: object::SectionText(), alignment: 4, data: move bytes, memory_size: size
        })
    object.symbols.push(object::Symbol {
            name: "main", kind: object::SymbolFunction(), binding: object::SymbolGlobal(), section: Some(0), offset: 0, size: size
        })
    object.entry = Some(0)
    return Ok(move object)
}

fn direct_frame_access(width: u32, load: bool) -> Result<void, Text> {
    let offsets: [u64; 3] = [0, u64.from(width), 4095 * u64.from(width)]
    for index in 0..3 {
        var bytes = Vec<u8>.new()
        let offset = offsets[index]
        arm64::emit_frame_access(bytes, 9, offset, width, load)?
        let expected = arm64::memory_word(9, 28, u32.from(offset), width, load)?
        testing::expect(bytes.length() == 4, "aligned frame access uses one instruction")?
        testing::expect(link_binary::number(bytes, 0, 4)? == u64.from(expected), "frame access encodes its base and scaled offset")?
    }
    return Ok(())
}

fn indirect_frame_access(offset: u64, width: u32, load: bool) -> Result<void, Text> {
    var expected = Vec<u8>.new()
    arm64::emit_frame_address(expected, 17, offset)?
    arm64::append_word(expected, arm64::memory_word(9, 17, 0, width, load)?)
    var bytes = Vec<u8>.new()
    arm64::emit_frame_access(bytes, 9, offset, width, load)?
    testing::expect(bytes.length() == expected.length(), "indirect frame access preserves address instructions")?
    for index in 0..bytes.length() {
        testing::expect(bytes[index] == expected[index], "indirect frame access preserves address encoding")?
    }
    return Ok(())
}

fn frame_access_encoding() -> Result<void, Text> {
    let widths: [u32; 4] = [1, 2, 4, 8]
    for index in 0..4 {
        let width = widths[index]
        direct_frame_access(width, false)?
        direct_frame_access(width, true)?
        indirect_frame_access(4096 * u64.from(width), width, false)?
        indirect_frame_access(arm64::FRAME_LIMIT, width, true)?
    }
    indirect_frame_access(1, 8, false)?
    return indirect_frame_access(4097, 8, true)
}

fn frame_access_failures() -> Result<void, Text> {
    var bytes = Vec<u8>.new()
    testing::error(arm64::emit_frame_access(bytes, 9, arm64::FRAME_LIMIT + 1, 8, true))?
    testing::error(arm64::emit_frame_access(bytes, 32, 0, 8, true))?
    testing::error(arm64::emit_frame_access(bytes, 9, 0, 0, true))?
    return testing::error(arm64::emit_frame_access(bytes, 9, 0, 16, false))
}

fn compact_frame_object(unused: usize) -> Result<object::CompilerObject, Text> {
    let integer = ir::TypeInteger(ir::IntegerWidth64())
    var function = ir::function_new("main", ir::signature_new(Vec<ir::Type>.new(), integer), ir::LinkageExport())
    for index in 0..unused {
        ir::function_new_value(function, integer)
        ir::function_constant(function, integer, ir::ConstantInteger(u64.from(index) + 256))
    }
    let answer = ir::function_constant(function, integer, ir::ConstantInteger(42))
    var block = ir::basic_block_new()
    block.terminator = Some(ir::TerminatorReturn(Some(answer)))
    function.blocks.push(move block)
    var program = ir::program_new()
    ir::program_add_function(program, ir::function_new("unused_import", ir::signature_new(Vec<ir::Type>.new(), ir::TypeVoid()), ir::LinkageImport()))
    ir::program_add_function(program, move function)
    return arm64::codegen(move program, arm64::AbiVariant::Aapcs64())
}

fn compact_frame_encoding() -> Result<void, Text> {
    let expected = compact_frame_object(0)?
    let actual = compact_frame_object(64)?
    let size = expected.sections[0].data.length()
    testing::expect(actual.sections[0].data.length() == size, "unused values and constants do not enlarge ARM64 code or frames")?
    for index in 0..size {
        testing::expect(actual.sections[0].data[index] == expected.sections[0].data[index], "compaction preserves live constant and frame encoding")?
    }
    return Ok(())
}

fn write_frame_object(arguments: Arguments) -> Result<void, Text> {
    if arguments.length() == 3 {
        let path = arguments[1].clone()
        let options = elf::Options {
            interpreter: arguments[2].clone(), libraries: elf::libraries(Vec<Text>.new())?, versions: Vec<elf::SymbolVersion>.new()
        }
        toolchain::write_bytes(path, elf::executable(frame_object()?, options)?)?
        toolchain::executable(path)?
    }
    return Ok(())
}

fn run(arguments: Arguments) -> Result<void, Text> {
    frame_layout()?
    frame_failures()?
    mixed_frame_layout()?
    frame_instruction_failures()?
    constant_frame_values()?
    stack_encoding()?
    frame_access_encoding()?
    frame_access_failures()?
    compact_frame_encoding()?
    return write_frame_object(arguments)
}

fn main(arguments: Arguments) -> u32 {
    return testing::done(run(arguments))
}
