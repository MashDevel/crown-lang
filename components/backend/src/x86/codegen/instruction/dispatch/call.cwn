module x86 {
    fn codegen_call_instruction(program: ir::Program, compiler: write FunctionCompiler, instruction: ir::Instruction) -> Option<Result<void, CodegenError>> {
        match read instruction.kind {
            ir::InstructionCall(function, arguments, result_type) => {
                result_type
                return Some(codegen_compile_call(program, compiler, CallInput {
                            result: instruction.result
                            function: function
                            arguments: codegen_values_copy(arguments)
                        }))
            }
            ir::InstructionCallIndirect(function, signature, arguments) => {
                return Some(codegen_compile_indirect_call(program, compiler, IndirectCallInput {
                            result: instruction.result
                            function: function
                            signature: ir::signature_copy(signature)
                            arguments: codegen_values_copy(arguments)
                        }))
            }
            _ => {
                return None()
            }
        }
    }

    fn codegen_values_copy(values: Vec<usize>) -> Vec<usize> {
        var output = Vec<usize>.with_capacity(values.length())
        var index: usize = 0
        while index < values.length() {
            output.push(values[index]);
            index = index + 1
        }
        return move output
    }
}
