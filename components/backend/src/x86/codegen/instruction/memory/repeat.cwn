module x86 {
    fn codegen_memory_repeat(program: ir::Program, compiler: write FunctionCompiler, input: take MemoryRepeatInput) -> Result<void, CodegenError> {
        let repeat = codegen_internal_label(compiler)
        let done = codegen_internal_label(compiler)
        match codegen_load_repeat_values(program, compiler, input) {
            Err(error) => {
                return Err(move error)
            }
            Ok(value) => {
                value
            }
        }
        codegen_emit(compiler, Test(R9(), R9()))
        codegen_emit(compiler, JumpIf(Equal(), local_label_copy(done)))
        codegen_emit(compiler, Label(local_label_copy(repeat)))
        codegen_emit(compiler, Move(Rsi(), R8()))
        codegen_emit(compiler, Move(Rcx(), R10()))
        codegen_emit(compiler, MoveBytes())
        codegen_emit(compiler, SubtractImmediate(R9(), 1))
        codegen_emit(compiler, JumpIf(NotEqual(), move repeat))
        codegen_emit(compiler, Label(move done))
        return Ok(())
    }

    fn codegen_load_repeat_values(program: ir::Program, compiler: write FunctionCompiler, input: MemoryRepeatInput) -> Result<void, CodegenError> {
        match codegen_load_value(program, compiler, ValueAccess {
                value: input.destination, register: Rdi()
            }) {
            Err(error) => {
                return Err(move error)
            }
            Ok(done) => {
                done
            }
        }
        match codegen_load_value(program, compiler, ValueAccess {
                value: input.source, register: R8()
            }) {
            Err(error) => {
                return Err(move error)
            }
            Ok(done) => {
                done
            }
        }
        match codegen_load_value(program, compiler, ValueAccess {
                value: input.element_size, register: R10()
            }) {
            Err(error) => {
                return Err(move error)
            }
            Ok(done) => {
                done
            }
        }
        return codegen_load_value(program, compiler, ValueAccess {
                value: input.count, register: R9()
            })
    }
}
