module x86 {
    fn root_runtime_publish() -> Function {
        var instructions = Vec<Instruction>.new()
        instructions.push(Push(Rbx()))
        instructions.push(Push(R12()))
        instructions.push(Push(R13()))
        instructions.push(SubtractImmediate(Rsp(), 16))
        instructions.push(Move(Rbx(), Rdi()))
        instructions.push(Move(R12(), Rcx()))
        instructions.push(Load(R13(), Rdi(), 8))
        instructions.push(CompareImmediate(R13(), 1024))
        instructions.push(JumpIf(AboveOrEqual(), InternalLabel(0)))
        instructions.push(Load(Rax(), Rdi(), 16))
        instructions.push(Test(Rax(), Rax()))
        instructions.push(JumpIf(NotEqual(), InternalLabel(0)))
        instructions.push(Move(Rdi(), Rsp()))
        instructions.push(Call("crown_root_register"))
        instructions.push(Call("__compiler_root_lock"))
        instructions.push(LoadSymbolAddress(R8(), "__compiler_root_declarations"))
        instructions.push(MultiplyImmediate(R13(), 40))
        instructions.push(Add(R8(), R13()))
        instructions.push(Load(Rax(), R8(), 0))
        instructions.push(CompareImmediate(Rax(), 1))
        instructions.push(JumpIf(NotEqual(), InternalLabel(0)))
        instructions.push(Load(Rax(), R8(), 16))
        instructions.push(Compare(Rax(), R12()))
        instructions.push(JumpIf(NotEqual(), InternalLabel(0)))
        instructions.push(Load(Rax(), Rsp(), 0))
        instructions.push(Store(R8(), 24, Rax()))
        instructions.push(Store(Rbx(), 8, Rax()))
        instructions.push(Load(Rax(), Rsp(), 8))
        instructions.push(Store(R8(), 32, Rax()))
        instructions.push(Store(Rbx(), 16, Rax()))
        instructions.push(MoveImmediate(Rax(), 2))
        instructions.push(Store(R8(), 0, Rax()))
        instructions.push(MoveImmediate(Rax(), 1))
        instructions.push(Store(Rbx(), 0, Rax()))
        root_runtime_unlock(instructions)
        instructions.push(AddImmediate(Rsp(), 16))
        instructions.push(Pop(R13()))
        instructions.push(Pop(R12()))
        instructions.push(Pop(Rbx()))
        root_runtime_return(instructions)
        instructions.push(Label(InternalLabel(0)))
        root_runtime_abort(instructions)
        return function_new("crown_root_declare_publish", move instructions)
    }
}
