module x86 {
    fn root_runtime_register() -> Function {
        var instructions = Vec<Instruction>.new()
        instructions.push(LoadSymbolAddress(R8(), "__compiler_root_entries"))
        instructions.push(Xor(R9(), R9()))
        instructions.push(Label(InternalLabel(0)))
        root_runtime_compare(instructions, 0, 4)
        instructions.push(JumpIf(NotEqual(), InternalLabel(2)))
        instructions.push(Load(R11(), R8(), 8))
        instructions.push(CompareImmediate(R11(), -1))
        instructions.push(JumpIf(Equal(), InternalLabel(1)))
        instructions.push(AddImmediate(R11(), 1))
        instructions.push(Store(R8(), 8, R11()))
        instructions.push(Store(R8(), 16, Rsi()))
        instructions.push(Store(R8(), 24, Rdx()))
        instructions.push(Store(R8(), 32, Rcx()))
        instructions.push(Store(Rdi(), 0, R9()))
        instructions.push(Store(Rdi(), 8, R11()))
        instructions.push(MoveImmediate(Rax(), 1))
        instructions.push(Store(R8(), 0, Rax()))
        root_runtime_return(instructions)
        instructions.push(Label(InternalLabel(1)))
        instructions.push(MoveImmediate(Rax(), 5))
        instructions.push(Store(R8(), 0, Rax()))
        instructions.push(Label(InternalLabel(2)))
        instructions.push(AddImmediate(R8(), 40))
        instructions.push(AddImmediate(R9(), 1))
        instructions.push(CompareImmediate(R9(), 1024))
        instructions.push(JumpIf(Below(), InternalLabel(0)))
        instructions.push(Push(Rbx()))
        instructions.push(Move(Rbx(), Rsi()))
        instructions.push(Move(Rdi(), Rsi()))
        instructions.push(CallRegister(Rdx()))
        instructions.push(Move(Rdi(), Rbx()))
        instructions.push(Call("free"))
        root_runtime_abort(instructions)
        return function_new("crown_root_register", move instructions)
    }

    fn root_runtime_destroy() -> Function {
        var instructions = Vec<Instruction>.new()
        instructions.push(Push(Rbx()))
        instructions.push(SubtractImmediate(Rsp(), 16))
        instructions.push(Move(Rbx(), Rdi()))
        instructions.push(Load(Rdi(), Rbx(), 16))
        instructions.push(Store(Rsp(), 0, Rdi()))
        instructions.push(Load(Rax(), Rbx(), 24))
        instructions.push(Xor(Rcx(), Rcx()))
        instructions.push(Store(Rbx(), 16, Rcx()))
        instructions.push(Store(Rbx(), 24, Rcx()))
        instructions.push(Store(Rbx(), 32, Rcx()))
        instructions.push(CallRegister(Rax()))
        instructions.push(Load(Rdi(), Rsp(), 0))
        instructions.push(Call("free"))
        instructions.push(Xor(Rax(), Rax()))
        instructions.push(Store(Rbx(), 0, Rax()))
        instructions.push(AddImmediate(Rsp(), 16))
        instructions.push(Pop(Rbx()))
        instructions.push(Return())
        return function_new("__compiler_root_destroy", move instructions)
    }
}
