module x86 {
    fn root_runtime_acquire() -> Function {
        var instructions = Vec<Instruction>.new()
        root_runtime_entry(instructions, Rsi(), 3)
        root_runtime_compare(instructions, 1, 2)
        instructions.push(JumpIf(NotEqual(), InternalLabel(2)))
        instructions.push(Load(Rax(), R8(), 8))
        instructions.push(Compare(Rax(), R11()))
        instructions.push(MoveImmediate(Rsi(), 1))
        instructions.push(JumpIf(NotEqual(), InternalLabel(1)))
        instructions.push(Load(Rax(), R8(), 32))
        instructions.push(Compare(Rax(), Rdx()))
        instructions.push(MoveImmediate(Rsi(), 3))
        instructions.push(JumpIf(NotEqual(), InternalLabel(1)))
        instructions.push(Load(Rax(), R8(), 16))
        instructions.push(Store(Rdi(), 8, Rax()))
        instructions.push(Store(Rdi(), 16, R8()))
        instructions.push(MoveImmediate(Rax(), 1))
        instructions.push(Store(Rdi(), 0, Rax()))
        root_runtime_return(instructions)
        root_runtime_reject_lease(instructions)
        instructions.push(Label(InternalLabel(2)))
        instructions.push(CompareImmediate(Rax(), 2))
        instructions.push(JumpIf(NotEqual(), InternalLabel(3)))
        instructions.push(MoveImmediate(Rsi(), 2))
        instructions.push(Jump(InternalLabel(4)))
        instructions.push(Label(InternalLabel(3)))
        instructions.push(MoveImmediate(Rsi(), 1))
        instructions.push(Label(InternalLabel(4)))
        instructions.push(SubtractImmediate(Rsp(), 8))
        instructions.push(Call("__compiler_root_failure"))
        instructions.push(AddImmediate(Rsp(), 8))
        instructions.push(Return())
        return function_new("crown_root_acquire", move instructions)
    }

    fn root_runtime_reject_lease(instructions: write Vec<Instruction>) -> void {
        instructions.push(Label(InternalLabel(1)))
        instructions.push(SubtractImmediate(Rsp(), 40))
        instructions.push(Store(Rsp(), 16, Rdi()))
        instructions.push(Store(Rsp(), 24, Rsi()))
        instructions.push(Load(Rax(), R8(), 16))
        instructions.push(Store(Rsp(), 0, Rax()))
        instructions.push(Store(Rsp(), 8, R8()))
        instructions.push(Move(Rdi(), Rsp()))
        instructions.push(Call("crown_root_release"))
        instructions.push(Load(Rdi(), Rsp(), 16))
        instructions.push(Load(Rsi(), Rsp(), 24))
        instructions.push(Call("__compiler_root_failure"))
        instructions.push(AddImmediate(Rsp(), 40))
        instructions.push(Return())
    }
}
