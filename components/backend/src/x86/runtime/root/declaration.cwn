module x86 {
    fn root_runtime_lock() -> Function {
        var instructions = Vec<Instruction>.new()
        instructions.push(LoadSymbolAddress(R11(), "__compiler_root_declaration_lock"))
        instructions.push(Label(InternalLabel(0)))
        instructions.push(MoveImmediate(R10(), 1))
        instructions.push(ExchangeMemory(CompareExchangeMemoryArgs {
                    address: R11(), value: R10(), width: Qword()
                }))
        instructions.push(Test(R10(), R10()))
        instructions.push(JumpIf(NotEqual(), InternalLabel(0)))
        instructions.push(Return())
        return function_new("__compiler_root_lock", move instructions)
    }

    fn root_runtime_unlock(instructions: write Vec<Instruction>) -> void {
        instructions.push(LoadSymbolAddress(R11(), "__compiler_root_declaration_lock"))
        instructions.push(Xor(R10(), R10()))
        instructions.push(Store(R11(), 0, R10()))
    }

    fn root_runtime_declare() -> Function {
        var instructions = Vec<Instruction>.new()
        instructions.push(SubtractImmediate(Rsp(), 8))
        instructions.push(Call("__compiler_root_lock"))
        instructions.push(LoadSymbolAddress(R8(), "__compiler_root_declarations"))
        instructions.push(Xor(R9(), R9()))
        instructions.push(MoveImmediate(Rcx(), 1024))
        root_runtime_declaration_scan(instructions)
        root_runtime_declaration_reserve(instructions)
        instructions.push(Label(InternalLabel(4)))
        instructions.push(CompareImmediate(Rax(), 2))
        instructions.push(JumpIf(NotEqual(), InternalLabel(5)))
        instructions.push(Load(Rax(), R8(), 24))
        instructions.push(Store(Rdi(), 8, Rax()))
        instructions.push(Load(Rax(), R8(), 32))
        instructions.push(Store(Rdi(), 16, Rax()))
        instructions.push(MoveImmediate(Rax(), 1))
        instructions.push(Store(Rdi(), 0, Rax()))
        instructions.push(Xor(Rax(), Rax()))
        instructions.push(Jump(InternalLabel(8)))
        instructions.push(Label(InternalLabel(5)))
        instructions.push(MoveImmediate(Rsi(), 2))
        instructions.push(Jump(InternalLabel(7)))
        instructions.push(Label(InternalLabel(6)))
        instructions.push(MoveImmediate(Rsi(), 4))
        instructions.push(Label(InternalLabel(7)))
        instructions.push(Call("__compiler_root_failure"))
        instructions.push(Label(InternalLabel(8)))
        root_runtime_unlock(instructions)
        instructions.push(AddImmediate(Rsp(), 8))
        instructions.push(Return())
        return function_new("crown_root_declare", move instructions)
    }

    fn root_runtime_declaration_scan(instructions: write Vec<Instruction>) -> void {
        instructions.push(Label(InternalLabel(0)))
        instructions.push(Load(Rax(), R8(), 0))
        instructions.push(Test(Rax(), Rax()))
        instructions.push(JumpIf(NotEqual(), InternalLabel(1)))
        instructions.push(CompareImmediate(Rcx(), 1024))
        instructions.push(ConditionalMove(Equal(), Rcx(), R9()))
        instructions.push(Jump(InternalLabel(2)))
        instructions.push(Label(InternalLabel(1)))
        instructions.push(Load(R10(), R8(), 8))
        instructions.push(Compare(R10(), Rsi()))
        instructions.push(JumpIf(NotEqual(), InternalLabel(2)))
        instructions.push(Load(R10(), R8(), 16))
        instructions.push(Compare(R10(), Rdx()))
        instructions.push(JumpIf(Equal(), InternalLabel(4)))
        instructions.push(Label(InternalLabel(2)))
        instructions.push(AddImmediate(R8(), 40))
        instructions.push(AddImmediate(R9(), 1))
        instructions.push(CompareImmediate(R9(), 1024))
        instructions.push(JumpIf(Below(), InternalLabel(0)))
    }

    fn root_runtime_declaration_reserve(instructions: write Vec<Instruction>) -> void {
        instructions.push(CompareImmediate(Rcx(), 1024))
        instructions.push(JumpIf(Equal(), InternalLabel(6)))
        instructions.push(LoadSymbolAddress(R8(), "__compiler_root_declarations"))
        instructions.push(Move(R9(), Rcx()))
        instructions.push(MultiplyImmediate(R9(), 40))
        instructions.push(Add(R8(), R9()))
        instructions.push(MoveImmediate(Rax(), 1))
        instructions.push(Store(R8(), 0, Rax()))
        instructions.push(Store(R8(), 8, Rsi()))
        instructions.push(Store(R8(), 16, Rdx()))
        instructions.push(Store(Rdi(), 0, Rax()))
        instructions.push(Store(Rdi(), 8, Rcx()))
        instructions.push(Xor(R10(), R10()))
        instructions.push(Store(Rdi(), 16, R10()))
        instructions.push(Jump(InternalLabel(8)))
    }
}
