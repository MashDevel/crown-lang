module x86 {
    fn root_runtime_close() -> Function {
        var instructions = Vec<Instruction>.new()
        instructions.push(SubtractImmediate(Rsp(), 8))
        root_runtime_entry(instructions, Rdi(), 3)
        instructions.push(Load(Rax(), R8(), 8))
        instructions.push(Compare(Rax(), R11()))
        instructions.push(JumpIf(NotEqual(), InternalLabel(3)))
        instructions.push(Xor(Rax(), Rax()))
        instructions.push(Store(Rdi(), 8, Rax()))
        instructions.push(MoveImmediate(Rax(), 1))
        instructions.push(Label(InternalLabel(0)))
        instructions.push(MoveImmediate(R10(), 4))
        instructions.push(CompareImmediate(Rax(), 1))
        instructions.push(JumpIf(Equal(), InternalLabel(1)))
        instructions.push(CompareImmediate(Rax(), 2))
        instructions.push(JumpIf(NotEqual(), InternalLabel(3)))
        instructions.push(MoveImmediate(R10(), 3))
        instructions.push(Label(InternalLabel(1)))
        instructions.push(CompareExchangeMemory(CompareExchangeMemoryArgs {
                    address: R8(), value: R10(), width: Qword()
                }))
        instructions.push(JumpIf(NotEqual(), InternalLabel(0)))
        instructions.push(CompareImmediate(R10(), 4))
        instructions.push(JumpIf(NotEqual(), InternalLabel(2)))
        instructions.push(Move(Rdi(), R8()))
        instructions.push(Call("__compiler_root_destroy"))
        instructions.push(Label(InternalLabel(2)))
        instructions.push(AddImmediate(Rsp(), 8))
        root_runtime_return(instructions)
        instructions.push(Label(InternalLabel(3)))
        root_runtime_abort(instructions)
        return function_new("crown_root_close", move instructions)
    }

    fn root_runtime_release() -> Function {
        var instructions = Vec<Instruction>.new()
        instructions.push(SubtractImmediate(Rsp(), 8))
        instructions.push(Load(R8(), Rdi(), 8))
        instructions.push(Xor(Rax(), Rax()))
        instructions.push(Store(Rdi(), 0, Rax()))
        instructions.push(Store(Rdi(), 8, Rax()))
        root_runtime_compare(instructions, 2, 1)
        instructions.push(JumpIf(Equal(), InternalLabel(0)))
        root_runtime_compare(instructions, 3, 4)
        instructions.push(JumpIf(NotEqual(), InternalLabel(1)))
        instructions.push(Move(Rdi(), R8()))
        instructions.push(Call("__compiler_root_destroy"))
        instructions.push(Label(InternalLabel(0)))
        instructions.push(AddImmediate(Rsp(), 8))
        root_runtime_return(instructions)
        instructions.push(Label(InternalLabel(1)))
        root_runtime_abort(instructions)
        return function_new("crown_root_release", move instructions)
    }
}
