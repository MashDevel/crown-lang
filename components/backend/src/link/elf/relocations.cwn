module elf {
    fn relocate(image: write Image, object: object::CompilerObject) -> Result<void, Text> {
        for index in 0..object.relocations.length() {
            relocate_one(image, object, object.relocations[index])?
        }
        return Ok(())
    }

    fn relocate_one(image: write Image, object: object::CompilerObject, relocation: object::Relocation) -> Result<void, Text> {
        validate_import_relocation(object, relocation)?
        let address = image.sections[relocation.section] + relocation.offset
        if arm64::arm_instruction_relocation(relocation.kind) {
            return relocate_arm_instruction(image, relocation, address)
        }
        if object::symbol_is_import(object.symbols[relocation.symbol].binding) && relocation.kind == object::RelocationAbsolute64() {
            if writable(object.sections[relocation.section]) == false {
                return Err("ELF dynamic absolute relocation requires writable storage")
            }
            dynamic_relocation(image, address, relocation.symbol, absolute_relocation(image.architecture), relocation.addend)
            return Ok(())
        }
        let value = resolved_relocation(image, relocation, address)?
        let offset = usize.from(address - IMAGE_BASE)
        link_binary::number(image.bytes, offset, usize.from(object::relocation_width(relocation.kind)))?
        link_binary::put(image.bytes, offset, u64.from_bits(value), usize.from(object::relocation_width(relocation.kind)))
        return Ok(())
    }

    fn resolved_relocation(image: write Image, relocation: object::Relocation, address: u64) -> Result<i64, Text> {
        let target = relocation_target(image, relocation)?
        var value = link_binary::signed_add(i64.from(target), relocation.addend)?
        match read relocation.subtract {
            Some(symbol) => {
                value = link_binary::signed_subtract(value, i64.from(image.symbols[symbol]))?
            }
            None => {
            }
        }
        return relocation_value(relocation.kind, value, address)
    }

    fn validate_import_relocation(object: object::CompilerObject, relocation: object::Relocation) -> Result<void, Text> {
        loan read object.symbols[relocation.symbol] as symbol {
            if object::symbol_is_import(symbol.binding) == false {
                return Ok(())
            }
            match relocation.kind {
                object::RelocationAbsolute64 | object::RelocationGotPcRelative32 | object::RelocationGotLoadPcRelative32 | object::RelocationArmGotPage21 | object::RelocationArmGotLoadPageOffset12 => {
                    return Ok(())
                }
                object::RelocationPcRelative32 | object::RelocationPcRelativeCall32 | object::RelocationArmBranch26 => {
                    if object::symbol_is_function(symbol.kind) {
                        return Ok(())
                    }
                }
                _ => {
                }
            }
        }
        return Err("ELF imported symbol requires a supported indirect or call relocation")
    }

    fn relocation_target(image: write Image, relocation: object::Relocation) -> Result<u64, Text> {
        match read relocation.kind {
            object::RelocationGotPcRelative32 | object::RelocationGotLoadPcRelative32 | object::RelocationArmGotPage21 | object::RelocationArmGotLoadPageOffset12 => {
                return got_slot(image, relocation.symbol)
            }
            _ => {
                return Ok(image.symbols[relocation.symbol])
            }
        }
    }

    fn got_slot(image: write Image, symbol: usize) -> Result<u64, Text> {
        if image.slots[symbol] == 0 {
            let offset = reserve(image, 8, 8)?
            image.slots[symbol] = IMAGE_BASE + u64.from(offset)
            link_binary::put(image.bytes, offset, image.symbols[symbol], 8)
        }
        return Ok(image.slots[symbol])
    }

    fn relocation_value(kind: object::RelocationKind, value: i64, address: u64) -> Result<i64, Text> {
        match read kind {
            object::RelocationPcRelative32 | object::RelocationPcRelativeCall32 | object::RelocationGotPcRelative32 | object::RelocationGotLoadPcRelative32 => {
                return relative_value(value, address)
            }
            object::RelocationAbsolute64 | object::RelocationDifference64 => {
                return Ok(value)
            }
            object::RelocationAbsolute32 => {
                if value >= 0 && value <= 4294967295 {
                    return Ok(value)
                }
            }
            object::RelocationDifference32 => {
                if value >= -2147483648 && value <= 2147483647 {
                    return Ok(value)
                }
            }
            _ => {
                return Err("unsupported ELF relocation")
            }
        }
        return Err("ELF relocation overflow")
    }
}
