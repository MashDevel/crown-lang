module optimize {
    struct ThreadPlan {
        source: usize
        through: usize
        terminator: ir::Terminator
        successors: Vec<ThreadSuccessor>
    }

    struct ThreadSuccessor {
        block: usize
        values: Vec<usize>
    }

    struct ThreadEdge {
        source: usize
        through: usize
        then_block: usize
        else_block: usize
    }

    fn thread_target_contains(values: Vec<usize>, target: usize) -> bool {
        var index: usize = 0
        while index < values.length() {
            if values[index] == target {
                return true
            };
            index = index + 1
        }
        return false
    }
}
