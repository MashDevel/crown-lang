module arm64 {
    fn root_acquire(output: write object::CompilerObject) -> Result<void, Text> {
        var compiler = runtime_compiler(32)
        prologue(compiler)
        root_entry(compiler, 1, 3)
        atomic_values(compiler, 1, 2)
        runtime_condition(compiler, 1, 2)
        runtime_memory(compiler, 12, 9, 8, true)
        emit_encoding(compiler, compare_word(12, 5))
        immediate(compiler, 1, 1)
        runtime_condition(compiler, 1, 1)
        runtime_memory(compiler, 12, 9, 32, true)
        emit_encoding(compiler, compare_word(12, 2))
        immediate(compiler, 1, 3)
        runtime_condition(compiler, 1, 1)
        runtime_memory(compiler, 12, 9, 16, true)
        runtime_memory(compiler, 12, 0, 8, false)
        runtime_memory(compiler, 9, 0, 16, false)
        immediate(compiler, 12, 1)
        runtime_memory(compiler, 12, 0, 0, false)
        root_success(compiler)
        root_reject_lease(compiler)
        runtime_label(compiler, 2)
        runtime_compare(compiler, 12, 2)
        runtime_condition(compiler, 1, 3)
        immediate(compiler, 1, 2)
        runtime_jump(compiler, 4)
        runtime_label(compiler, 3)
        immediate(compiler, 1, 1)
        runtime_label(compiler, 4)
        call_symbol(compiler, "__compiler_root_failure")
        epilogue(compiler)
        return runtime_finish(output, compiler, "crown_root_acquire")
    }
    fn root_reject_lease(compiler: write Compiler) -> void {
        runtime_label(compiler, 1)
        frame_access(compiler, 0, 16, 8, false)
        frame_access(compiler, 1, 24, 8, false)
        runtime_memory(compiler, 12, 9, 16, true)
        frame_access(compiler, 12, 0, 8, false)
        frame_access(compiler, 9, 8, 8, false)
        frame_address(compiler, 0, 0)
        call_symbol(compiler, "crown_root_release")
        frame_access(compiler, 0, 16, 8, true)
        frame_access(compiler, 1, 24, 8, true)
        call_symbol(compiler, "__compiler_root_failure")
        return epilogue(compiler)
    }

}
