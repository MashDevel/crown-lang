module arm64 {
    fn root_close(output: write object::CompilerObject) -> Result<void, Text> {
        var compiler = runtime_compiler(0)
        prologue(compiler)
        root_entry(compiler, 0, 3)
        runtime_memory(compiler, 12, 9, 8, true)
        emit_encoding(compiler, compare_word(12, 5))
        runtime_condition(compiler, 1, 3)
        runtime_memory(compiler, 31, 0, 8, false)
        immediate(compiler, 12, 1)
        runtime_label(compiler, 0)
        runtime_move(compiler, 10, 12)
        immediate(compiler, 11, 4)
        runtime_compare(compiler, 12, 1)
        runtime_condition(compiler, 0, 1)
        runtime_compare(compiler, 12, 2)
        runtime_condition(compiler, 1, 3)
        immediate(compiler, 11, 3)
        runtime_label(compiler, 1)
        atomic_compare(compiler)
        runtime_condition(compiler, 1, 0)
        runtime_compare(compiler, 11, 4)
        runtime_condition(compiler, 1, 2)
        runtime_move(compiler, 0, 9)
        call_symbol(compiler, "__compiler_root_destroy")
        runtime_label(compiler, 2)
        root_success(compiler)
        runtime_label(compiler, 3)
        root_abort(compiler)
        return runtime_finish(output, compiler, "crown_root_close")
    }
    fn root_release(output: write object::CompilerObject) -> Result<void, Text> {
        var compiler = runtime_compiler(0)
        prologue(compiler)
        runtime_memory(compiler, 9, 0, 8, true)
        runtime_memory(compiler, 31, 0, 0, false)
        runtime_memory(compiler, 31, 0, 8, false)
        atomic_values(compiler, 2, 1)
        runtime_condition(compiler, 0, 0)
        atomic_values(compiler, 3, 4)
        runtime_condition(compiler, 1, 1)
        runtime_move(compiler, 0, 9)
        call_symbol(compiler, "__compiler_root_destroy")
        runtime_label(compiler, 0)
        root_success(compiler)
        runtime_label(compiler, 1)
        root_abort(compiler)
        return runtime_finish(output, compiler, "crown_root_release")
    }

}
