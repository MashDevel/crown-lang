module arm64 {
    fn root_lock(compiler: write Compiler) -> void {
        symbol_address(compiler, "__compiler_root_declaration_lock", 9)
        runtime_label(compiler, 20)
        atomic_values(compiler, 0, 1)
        return runtime_condition(compiler, 1, 20)
    }
    fn root_unlock(compiler: write Compiler) -> void {
        symbol_address(compiler, "__compiler_root_declaration_lock", 9)
        return atomic_publish(compiler, 0)
    }
    fn root_declare(output: write object::CompilerObject) -> Result<void, Text> {
        var compiler = runtime_compiler(0)
        prologue(compiler)
        root_lock(compiler)
        symbol_address(compiler, "__compiler_root_declarations", 9)
        immediate(compiler, 4, 0)
        immediate(compiler, 6, 1024)
        declaration_scan(compiler)
        declaration_reserve(compiler)
        runtime_label(compiler, 4)
        runtime_compare(compiler, 12, 2)
        runtime_condition(compiler, 1, 5)
        runtime_memory(compiler, 12, 9, 24, true)
        runtime_memory(compiler, 12, 0, 8, false)
        runtime_memory(compiler, 12, 9, 32, true)
        runtime_memory(compiler, 12, 0, 16, false)
        immediate(compiler, 12, 1)
        runtime_memory(compiler, 12, 0, 0, false)
        immediate(compiler, 0, 0)
        runtime_jump(compiler, 8)
        runtime_label(compiler, 5)
        immediate(compiler, 1, 2)
        runtime_jump(compiler, 7)
        runtime_label(compiler, 6)
        immediate(compiler, 1, 4)
        runtime_label(compiler, 7)
        call_symbol(compiler, "__compiler_root_failure")
        runtime_label(compiler, 8)
        root_unlock(compiler)
        epilogue(compiler)
        return runtime_finish(output, compiler, "crown_root_declare")
    }
    fn declaration_scan(compiler: write Compiler) -> void {
        runtime_label(compiler, 0)
        runtime_memory(compiler, 12, 9, 0, true)
        runtime_compare(compiler, 12, 0)
        runtime_condition(compiler, 1, 1)
        runtime_compare(compiler, 6, 1024)
        emit_encoding(compiler, select_word(Registers {
                    destination: 6, left: 4, right: 6
                }, 0))
        runtime_jump(compiler, 2)
        runtime_label(compiler, 1)
        runtime_memory(compiler, 10, 9, 8, true)
        emit_encoding(compiler, compare_word(10, 1))
        runtime_condition(compiler, 1, 2)
        runtime_memory(compiler, 10, 9, 16, true)
        emit_encoding(compiler, compare_word(10, 2))
        runtime_condition(compiler, 0, 4)
        runtime_label(compiler, 2)
        emit_encoding(compiler, add_immediate(9, 9, 40, false))
        emit_encoding(compiler, add_immediate(4, 4, 1, false))
        runtime_compare(compiler, 4, 1024)
        return runtime_condition(compiler, 3, 0)
    }
    fn declaration_reserve(compiler: write Compiler) -> void {
        runtime_compare(compiler, 6, 1024)
        runtime_condition(compiler, 0, 6)
        symbol_address(compiler, "__compiler_root_declarations", 9)
        immediate(compiler, 15, 40)
        emit_registers(compiler, 2600500224, 4, 6, 15)
        emit_registers(compiler, 2332033024, 9, 9, 4)
        immediate(compiler, 12, 1)
        runtime_memory(compiler, 12, 9, 0, false)
        runtime_memory(compiler, 1, 9, 8, false)
        runtime_memory(compiler, 2, 9, 16, false)
        runtime_memory(compiler, 12, 0, 0, false)
        runtime_memory(compiler, 6, 0, 8, false)
        runtime_memory(compiler, 31, 0, 16, false)
        immediate(compiler, 0, 1)
        return runtime_jump(compiler, 8)
    }

}
