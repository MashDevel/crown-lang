module arm64 {
    fn root_register(output: write object::CompilerObject) -> Result<void, Text> {
        var compiler = runtime_compiler(16)
        prologue(compiler)
        symbol_address(compiler, "__compiler_root_entries", 9)
        immediate(compiler, 4, 0)
        runtime_label(compiler, 0)
        atomic_values(compiler, 0, 4)
        runtime_condition(compiler, 1, 2)
        runtime_memory(compiler, 5, 9, 8, true)
        runtime_compare(compiler, 5, 18446744073709551615)
        runtime_condition(compiler, 0, 1)
        emit_encoding(compiler, add_immediate(5, 5, 1, false))
        runtime_memory(compiler, 5, 9, 8, false)
        runtime_memory(compiler, 1, 9, 16, false)
        runtime_memory(compiler, 2, 9, 24, false)
        runtime_memory(compiler, 3, 9, 32, false)
        runtime_memory(compiler, 4, 0, 0, false)
        runtime_memory(compiler, 5, 0, 8, false)
        atomic_publish(compiler, 1)
        root_success(compiler)
        runtime_label(compiler, 1)
        atomic_publish(compiler, 5)
        runtime_label(compiler, 2)
        emit_encoding(compiler, add_immediate(9, 9, 40, false))
        emit_encoding(compiler, add_immediate(4, 4, 1, false))
        runtime_compare(compiler, 4, 1024)
        runtime_condition(compiler, 3, 0)
        frame_access(compiler, 1, 0, 8, false)
        runtime_move(compiler, 0, 1)
        emit_encoding(compiler, indirect_branch(2, true))
        frame_access(compiler, 0, 0, 8, true)
        call_symbol(compiler, "free")
        root_abort(compiler)
        return runtime_finish(output, compiler, "crown_root_register")
    }
    fn root_destroy(output: write object::CompilerObject) -> Result<void, Text> {
        var compiler = runtime_compiler(16)
        prologue(compiler)
        frame_access(compiler, 0, 8, 8, false)
        runtime_move(compiler, 9, 0)
        runtime_memory(compiler, 0, 9, 16, true)
        runtime_memory(compiler, 16, 9, 24, true)
        frame_access(compiler, 0, 0, 8, false)
        runtime_memory(compiler, 31, 9, 16, false)
        runtime_memory(compiler, 31, 9, 24, false)
        runtime_memory(compiler, 31, 9, 32, false)
        emit_encoding(compiler, indirect_branch(16, true))
        frame_access(compiler, 0, 0, 8, true)
        call_symbol(compiler, "free")
        frame_access(compiler, 9, 8, 8, true)
        atomic_publish(compiler, 0)
        epilogue(compiler)
        return runtime_finish(output, compiler, "__compiler_root_destroy")
    }

}
