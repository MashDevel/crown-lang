module arm64 {
    fn root_publish(output: write object::CompilerObject) -> Result<void, Text> {
        var compiler = runtime_compiler(48)
        prologue(compiler)
        frame_access(compiler, 0, 16, 8, false)
        frame_access(compiler, 3, 24, 8, false)
        runtime_memory(compiler, 4, 0, 8, true)
        frame_access(compiler, 4, 32, 8, false)
        runtime_compare(compiler, 4, 1024)
        runtime_condition(compiler, 2, 0)
        runtime_memory(compiler, 12, 0, 16, true)
        runtime_compare(compiler, 12, 0)
        runtime_condition(compiler, 1, 0)
        frame_address(compiler, 0, 0)
        call_symbol(compiler, "crown_root_register")
        root_lock(compiler)
        symbol_address(compiler, "__compiler_root_declarations", 9)
        frame_access(compiler, 4, 32, 8, true)
        immediate(compiler, 15, 40)
        emit_registers(compiler, 2600500224, 4, 4, 15)
        emit_registers(compiler, 2332033024, 9, 9, 4)
        runtime_memory(compiler, 12, 9, 0, true)
        runtime_compare(compiler, 12, 1)
        runtime_condition(compiler, 1, 0)
        runtime_memory(compiler, 12, 9, 16, true)
        frame_access(compiler, 3, 24, 8, true)
        emit_encoding(compiler, compare_word(12, 3))
        runtime_condition(compiler, 1, 0)
        publish_token(compiler)
        root_unlock(compiler)
        root_success(compiler)
        runtime_label(compiler, 0)
        root_abort(compiler)
        return runtime_finish(output, compiler, "crown_root_declare_publish")
    }
    fn publish_token(compiler: write Compiler) -> void {
        frame_access(compiler, 0, 16, 8, true)
        frame_access(compiler, 12, 0, 8, true)
        runtime_memory(compiler, 12, 9, 24, false)
        runtime_memory(compiler, 12, 0, 8, false)
        frame_access(compiler, 12, 8, 8, true)
        runtime_memory(compiler, 12, 9, 32, false)
        runtime_memory(compiler, 12, 0, 16, false)
        immediate(compiler, 12, 2)
        runtime_memory(compiler, 12, 9, 0, false)
        immediate(compiler, 12, 1)
        return runtime_memory(compiler, 12, 0, 0, false)
    }

}
