module arm64 {
    fn compile_float_binary(compiler: write Compiler, operator: ir::BinaryOperator, value_type: ir::Type, left: usize, right: usize) -> Result<void, Text> {
        let double = ir::type_is_float64(value_type)
        compiler.float_result = true
        if operator == ir::BinaryFloatRemainder() {
            float_value_load(compiler, left, 0, value_type)?
            float_value_load(compiler, right, 1, value_type)?
            call_symbol(compiler, if double {
                    "fmod"
                } else {
                    "fmodf"
                })
            compiler.result_register = 0
            return Ok(())
        }
        let operation = float_operation(operator)?
        let first = float_value_register(compiler, left, 0, value_type)?
        let second = float_value_register(compiler, right, 1, value_type)?
        compiler.result_register = compiler.float_target
        emit_encoding(compiler, float_word(operation, Registers {
                    destination: compiler.float_target, left: first, right: second
                }, double))
        return Ok(())
    }
    fn float_operation(operator: ir::BinaryOperator) -> Result<FloatOperation, Text> {
        return match operator {
            ir::BinaryFloatAdd => Ok(FloatOperation::Add())
            ir::BinaryFloatSubtract => Ok(FloatOperation::Subtract())
            ir::BinaryFloatMultiply => Ok(FloatOperation::Multiply())
            ir::BinaryFloatDivide => Ok(FloatOperation::Divide())
            _ => Err("invalid ARM64 floating operation")
        }
    }

    fn compile_float_negate(compiler: write Compiler, value: usize, value_type: ir::Type) -> Result<void, Text> {
        let source = float_value_register(compiler, value, 0, value_type)?
        compiler.float_result = true
        compiler.result_register = compiler.float_target
        emit_encoding(compiler, float_negate(compiler.float_target, source, ir::type_is_float64(value_type)))
        return Ok(())
    }

    fn compile_cast(function: ir::Function, compiler: write Compiler, operator: ir::CastOperator, value: usize, target: ir::Type) -> Result<void, Text> {
        let source = function.values[value]
        if operator == ir::CastFloatExtend() || operator == ir::CastFloatTruncate() {
            let register = float_value_register(compiler, value, 0, source)?
            compiler.float_result = true
            compiler.result_register = compiler.float_target
            emit_encoding(compiler, float_convert(compiler.float_target, register, ir::type_is_float64(target)))
            return Ok(())
        }
        return compile_scalar_cast(compiler, operator, value, source, target)
    }

    fn compile_scalar_cast(compiler: write Compiler, operator: ir::CastOperator, value: usize, source: ir::Type, target: ir::Type) -> Result<void, Text> {
        value_load(compiler, value, 9)
        value_high(compiler, value, 10)
        match operator {
            ir::CastSignExtend => {
                normalize(compiler, source, 9, true)
                immediate(compiler, 11, 63)
                emit_encoding(compiler, shift_word(ShiftOperation::ArithmeticRight(), Registers {
                            destination: 10, left: 9, right: 11
                        }))
            }
            ir::CastZeroExtend => {
                immediate(compiler, 10, 0)
            }
            ir::CastSignedIntegerToFloat | ir::CastUnsignedIntegerToFloat => {
                if value_size(source)? == 16 {
                    return wide_to_float(compiler, target, operator == ir::CastSignedIntegerToFloat())
                }
                normalize(compiler, source, 9, operator == ir::CastSignedIntegerToFloat())
                let double = ir::type_is_float64(target)
                compiler.float_result = true
                compiler.result_register = compiler.float_target
                emit_encoding(compiler, float_integer_convert(compiler.float_target, 9, double, operator == ir::CastUnsignedIntegerToFloat(), true))
            }
            ir::CastFloatToSignedInteger | ir::CastFloatToUnsignedInteger => {
                if value_size(target)? == 16 {
                    return float_to_wide(compiler, source, operator == ir::CastFloatToSignedInteger())
                }
                let double = ir::type_is_float64(source)
                emit_encoding(compiler, float_move_bits(0, 9, true, double))
                emit_encoding(compiler, float_integer_convert(9, 0, double, operator == ir::CastFloatToUnsignedInteger(), false))
            }
            _ => {
            }
        }
        return Ok(())
    }

}
