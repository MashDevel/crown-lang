module arm64 {
    fn assembly(object: object::CompilerObject, prefix: Text, variant: AbiVariant) -> Result<Text, Text> {
        if variant == AbiVariant::Darwin() {
            return native_assembly(object, prefix, false)
        }
        if variant == AbiVariant::Windows() {
            return native_assembly(object, prefix, true)
        }
        return elf_assembly(object, prefix)
    }
}
