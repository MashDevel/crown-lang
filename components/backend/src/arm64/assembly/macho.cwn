module arm64 {
    fn macho_assembly(object: object::CompilerObject, prefix: Text) -> Result<Text, Text> {
        if object.architecture != object::ArchitectureArm64() {
            return Err("ARM64 assembly requires an ARM64 object")
        }
        let relocations = assembly_relocation_index(object)?
        var output = ".build_version macos, 11, 0\n"
        for index in 0..object.sections.length() {
            macho_assembly_section(object, output, prefix, index, relocations[index])?
        }
        macho_assembly_symbols(object, output, prefix)
        return Ok(move output)
    }
    fn assembly_relocation_index(object: object::CompilerObject) -> Result<Vec<Vec<usize>>, Text> {
        var sections = Vec<Vec<usize>>.new()
        for index in 0..object.sections.length() {
            index;
            sections.push(Vec<usize>.new())
        }
        for index in 0..object.relocations.length() {
            let section = object.relocations[index].section
            if section >= sections.length() {
                return Err("assembly relocation has an invalid section")
            }
            sections[section].push(index)
            var position = sections[section].length() - 1
            while position > 0 && object.relocations[sections[section][position - 1]].offset > object.relocations[index].offset {
                sections[section][position] = sections[section][position - 1]
                position = position - 1
            }
            sections[section][position] = index
        }
        return Ok(move sections)
    }
    fn macho_assembly_section(object: object::CompilerObject, output: write Text, prefix: Text, index: usize, relocations: Vec<usize>) -> Result<void, Text> {
        loan read object.sections[index] as section {
            std::text::append(output, if object::section_is_executable(section.kind) {
                    ".text\n"
                } else {
                    ".data\n"
                })
            std::text::append(output, std::text::joined(".balign ", std::text::decimal(section.alignment)))
            std::text::append(output, std::text::joined("\n", assembly_base(prefix, index)))
            std::text::append(output, ":\n")
            macho_assembly_contents(object, output, index, relocations)?
            if section.memory_size > u64.from(section.data.length()) {
                std::text::append(output, std::text::joined(".space ", std::text::decimal(section.memory_size - u64.from(section.data.length()))))
                output.push('\n')
            }
        }
        return Ok(())
    }
    fn macho_assembly_symbols(object: object::CompilerObject, output: write Text, prefix: Text) -> void {
        for index in 0..object.symbols.length() {
            loan read object.symbols[index] as symbol {
                let global = match read symbol.binding {
                    object::SymbolGlobal => true,
                    _ => false
                }
                if global {
                    std::text::append(output, std::text::joined(".globl _", symbol.name))
                    output.push('\n')
                }
                match symbol.section {
                    Some(section) => {
                        std::text::append(output, std::text::joined(".set _", symbol.name))
                        std::text::append(output, std::text::joined(", ", assembly_base(prefix, section)))
                        std::text::append(output, std::text::joined("+", std::text::decimal(symbol.offset)))
                        output.push('\n')
                    }
                    None => {
                    }
                }
            }
        }
        match object.entry {
            Some(index) => {
                std::text::append(output, ".globl _main\n")
                if std::text::equal(object.symbols[index].name, "main") == false {
                    std::text::append(output, std::text::joined(".set _main, _", object.symbols[index].name))
                    output.push('\n')
                }
            }
            None => {
            }
        }
    }
    fn macho_assembly_contents(object: object::CompilerObject, output: write Text, index: usize, relocations: Vec<usize>) -> Result<void, Text> {
        var offset: usize = 0
        for position in 0..relocations.length() {
            loan read object.relocations[relocations[position]] as relocation {
                let end = usize.from(relocation.offset)
                if end < offset {
                    return Err("overlapping assembly relocations")
                }
                assembly_bytes(output, link_binary::part(object.sections[index].data, offset, end - offset)?)
                macho_assembly_relocation(object, output, relocation)?
                offset = end + usize.from(object::relocation_width(relocation.kind))
            }
        }
        if offset > object.sections[index].data.length() {
            return Err("assembly relocation exceeds its section")
        }
        assembly_bytes(output, link_binary::part(object.sections[index].data, offset, object.sections[index].data.length() - offset)?)
        return Ok(())
    }
}
