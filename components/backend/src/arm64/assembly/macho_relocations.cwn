module arm64 {
    fn macho_assembly_relocation(object: object::CompilerObject, output: write Text, relocation: object::Relocation) -> Result<void, Text> {
        var symbol = std::text::joined("_", object.symbols[relocation.symbol].name)
        match relocation.subtract {
            Some(index) => {
                std::text::append(symbol, std::text::joined("-_", object.symbols[index].name))
            }
            None => {
            }
        }
        if arm_instruction_relocation(relocation.kind) {
            if ir::value_present(relocation.subtract) {
                return Err("ARM64 instruction relocation cannot subtract a symbol")
            }
            let word = u32.from(link_binary::number(object.sections[relocation.section].data, usize.from(relocation.offset), 4)?)
            std::text::append(output, macho_assembly_instruction(relocation.kind, word, symbol, relocation.addend)?)
        } else {
            assembly_addend(symbol, relocation.addend)
            let directive = match relocation.kind {
                object::RelocationAbsolute64 | object::RelocationDifference64 => ".quad "
                object::RelocationAbsolute32 | object::RelocationDifference32 => ".long "
                _ => {
                    return Err("unsupported ARM64 Mach-O assembly relocation")
                }
            }
            std::text::append(output, std::text::joined(directive, symbol))
        }
        output.push('\n')
        return Ok(())
    }
    fn macho_assembly_instruction(kind: object::RelocationKind, word: u32, symbol: Text, addend: i64) -> Result<Text, Text> {
        arm_relocated_word(kind, word, 0, 0)?
        let destination = std::text::joined("x", std::text::decimal(u64.from(word & 31)))
        let base = if ((word >> 5) & 31) == 31 {
            "sp"
        } else {
            std::text::joined("x", std::text::decimal(u64.from((word >> 5) & 31)))
        }
        match kind {
            object::RelocationArmBranch26 => Ok(std::text::joined(if (word & 2147483648) != 0 {
                        "bl "
                    } else {
                        "b "
                    }, macho_symbol_expression(symbol, "", addend)))
            object::RelocationArmPage21 | object::RelocationArmGotPage21 => {
                let suffix = if kind == object::RelocationArmPage21() {
                    "@PAGE"
                } else {
                    "@GOTPAGE"
                }
                return Ok(std::text::joined(std::text::joined("adrp ", destination), std::text::joined(", ", macho_symbol_expression(symbol, suffix, addend))))
            }
            object::RelocationArmPageOffset12 => {
                let operands = std::text::joined(std::text::joined(destination, ", "), std::text::joined(base, ", "))
                return Ok(std::text::joined(std::text::joined("add ", operands), macho_symbol_expression(symbol, "@PAGEOFF", addend)))
            }
            object::RelocationArmGotLoadPageOffset12 => {
                let operands = std::text::joined(std::text::joined("ldr ", destination), std::text::joined(", [", base))
                return Ok(std::text::joined(operands, std::text::joined(", ", std::text::joined(macho_symbol_expression(symbol, "@GOTPAGEOFF", addend), "]"))))
            }
            object::RelocationArmLoadPageOffset12(scale) => macho_assembly_load(word, scale, macho_symbol_expression(symbol, "@PAGEOFF", addend))
            _ => Err("unsupported ARM64 Mach-O instruction relocation")
        }
    }
    fn macho_assembly_load(word: u32, scale: u32, symbol: Text) -> Result<Text, Text> {
        var operation = macho_memory_operation(word, scale)
        let register = macho_memory_register(word, scale)?
        std::text::append(operation, std::text::joined(" ", register))
        std::text::append(operation, std::text::decimal(u64.from(word & 31)))
        std::text::append(operation, ", [")
        let base = (word >> 5) & 31
        std::text::append(operation, if base == 31 {
                "sp"
            } else {
                std::text::joined("x", std::text::decimal(u64.from(base)))
            })
        std::text::append(operation, std::text::joined(", ", std::text::joined(symbol, "]")))
        return Ok(move operation)
    }
    fn macho_memory_operation(word: u32, scale: u32) -> Text {
        var operation = if (word & 4194304) != 0 {
            "ldr"
        } else {
            "str"
        }
        if (word & 67108864) == 0 {
            if scale == 0 {
                std::text::append(operation, "b")
            }
            if scale == 1 {
                std::text::append(operation, "h")
            }
        }
        return move operation
    }
    fn macho_memory_register(word: u32, scale: u32) -> Result<Text, Text> {
        if (word & 67108864) != 0 {
            return Ok(match scale {
                    0 => "b",
                    1 => "h",
                    2 => "s",
                    3 => "d",
                    _ => "q"
                })
        }
        if (word & 8388608) != 0 {
            return Err("unsupported signed load in Mach-O assembly")
        }
        return Ok(if scale == 3 {
                "x"
            } else {
                "w"
            })
    }
    fn macho_symbol_expression(symbol: Text, suffix: Text, addend: i64) -> Text {
        var output = std::text::joined(symbol, suffix)
        assembly_addend(output, addend)
        return move output
    }
}
