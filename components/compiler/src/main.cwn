fn text_view_is(value: TextView, expected: TextView) -> bool {
    return std::text::equal(value, expected)
}

fn main(arguments: Arguments) -> u32 {
    let values = toolchain::arguments(arguments)
    match crown_platform_command(values) {
        Ok(status) => status
        Err(error) => {
            toolchain::failure(error);
            1
        }
    }
}

fn crown_command(arguments: Vec<Text>) -> Result<u32, Text> {
    let options = toolchain::parse_options(arguments)?
    if options.help {
        toolchain::write_stream(1, toolchain::help());
        return Ok(0)
    }
    if std::text::equal(options.command, "--version") {
        toolchain::say(toolchain::version());
        return Ok(0)
    }
    return crown_platform_options(arguments, options)
}
