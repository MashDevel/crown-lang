module sema {
    fn validate_type_rules(symbols: write Symbols) -> void {
        var symbol: usize = 0
        while symbol < symbols.types.length() {
            symbols.current_span = symbols.types[symbol].name.span
            let errors = declaration_type_errors(symbols, symbols.types[symbol])
            if errors != 0 {
                symbols.errors = symbols.errors + errors - 1
                symbols_error(symbols, "invalid type declaration: copy fields must be copyable and stored fields cannot contain borrowed views")
            }
            symbol = symbol + 1
        }
    }

    fn declaration_type_errors(symbols: Symbols, declaration: Symbol) -> u32 {
        var errors: u32 = 0
        if copy_declaration_valid(symbols, declaration) == false {
            errors = errors + 1
        }
        var field: usize = 0
        while field < declaration.fields.length() {
            errors = errors + field_type_errors(symbols, declaration.fields[field].value_type, declaration.view_value)
            field = field + 1
        }
        var variant: usize = 0
        while variant < declaration.variants.length() {
            if variant_has_temporary(symbols, declaration.variants[variant]) {
                errors = errors + 1
            }
            variant = variant + 1
        }
        return errors
    }

    fn field_type_errors(symbols: Symbols, value_type: Type, scoped: bool) -> u32 {
        var errors: u32 = 0
        if type_is_unit(value_type) {
            errors = errors + 1
        }
        if scoped {
            if view_field_valid(symbols, value_type) == false {
                errors = errors + 1
            }
        } else {
            if type_contains_view(symbols, value_type) {
                errors = errors + 1
            }
        }
        if callable_views_valid(symbols, value_type) == false {
            errors = errors + 1
        }
        return errors
    }

    fn copy_declaration_valid(symbols: Symbols, declaration: Symbol) -> bool {
        if declaration.copy_value == false {
            return true
        }
        var index: usize = 0
        while index < declaration.fields.length() {
            loan read declaration.fields[index] as field {
                if type_is_copy_with_symbols(symbols, field.value_type) == false {
                    return false
                }
            }
            index = index + 1
        }
        var variant: usize = 0
        while variant < declaration.variants.length() {
            var field: usize = 0
            while field < declaration.variants[variant].fields.length() {
                loan read declaration.variants[variant].fields[field] as value {
                    if type_is_copy_with_symbols(symbols, value) == false {
                        return false
                    }
                }
                field = field + 1
            }
            variant = variant + 1
        }
        return true
    }

    fn variant_has_temporary(symbols: Symbols, variant: Variant) -> bool {
        var index: usize = 0
        while index < variant.fields.length() {
            loan read variant.fields[index] as field {
                if type_contains_view(symbols, field) || callable_views_valid(symbols, field) == false {
                    return true
                }
            }
            index = index + 1
        }
        return false
    }

    fn validate_variant_names(symbols: write Symbols) -> void {
        var symbol: usize = 0
        while symbol < symbols.types.length() {
            var variant: usize = 0
            while variant < symbols.types[symbol].variants.length() {
                var duplicates: usize = 0
                loan read symbols.types[symbol].variants[variant] as value {
                    duplicates = variant_name_count(symbols, value.name)
                }
                if duplicates > 1 {
                    symbols_error(symbols, "duplicate variant name")
                }
                variant = variant + 1
            }
            symbol = symbol + 1
        }
    }

    fn variant_name_count(symbols: Symbols, name: frontend::Name) -> usize {
        var count: usize = 0
        var symbol: usize = 0
        while symbol < symbols.types.length() {
            var variant: usize = 0
            while variant < symbols.types[symbol].variants.length() {
                loan read symbols.types[symbol].variants[variant] as value {
                    if variant_name_matches(symbols.source, value.name, name) {
                        count = count + 1
                    }
                }
                variant = variant + 1
            }
            symbol = symbol + 1
        }
        if name_is(symbols.source, name, "Some") || name_is(symbols.source, name, "None") {
            count = count + 1
        }
        if name_is(symbols.source, name, "Ok") || name_is(symbols.source, name, "Err") {
            count = count + 1
        }
        return count
    }
}
