module sema {
    fn type_is_integer(value_type: Type) -> bool {
        match read value_type {
            BuiltinType(builtin, arguments) => {
                arguments;
                return builtin_is_integer(builtin)
            }
            _ => {
                return false
            }
        }
    }

    fn type_is_numeric(value_type: Type) -> bool {
        return type_is_integer(value_type) || type_is_float(value_type)
    }

    fn type_is_float(value_type: Type) -> bool {
        match read value_type {
            BuiltinType(builtin, arguments) => {
                arguments
                let kind = builtin
                return kind == F32() || kind == F64()
            }
            _ => {
                return false
            }
        }
    }

    fn type_is_copy(value_type: Type) -> bool {
        match read value_type {
            BuiltinType(builtin, arguments) => {
                arguments;
                return builtin_is_copy(builtin)
            }
            ArrayType(element, length) => {
                length;
                loan read element as value {
                    return type_is_copy(value)
                }
            }
            FunctionType(parameters, result) => {
                parameters;
                result;
                return true
            }
            IntegerLiteral(value) => {
                value;
                return true
            }
            FloatLiteral => {
                return true
            }
            _ => {
                return false
            }
        }
    }

    fn type_is_copy_with_symbols(symbols: Symbols, value_type: Type) -> bool {
        if type_is_copy(value_type) {
            return true
        }
        match read value_type {
            BuiltinType(builtin, arguments) => {
                if builtin_copies_arguments(builtin, arguments.length()) {
                    return arguments_are_copy(symbols, arguments)
                }
                return false
            }
            ArrayType(element, length) => {
                length;
                loan read element as value {
                    return type_is_copy_with_symbols(symbols, value)
                }
            }
            NamedType(symbol, arguments) => {
                arguments
                if symbol >= symbols.types.length() {
                    return false
                }
                return symbols.types[symbol].copy_value
            }
            _ => {
                return false
            }
        }
    }

    fn arguments_are_copy(symbols: Symbols, arguments: Vec<Type>) -> bool {
        var index: usize = 0
        while index < arguments.length() {
            loan read arguments[index] as argument {
                if type_is_copy_with_symbols(symbols, argument) == false {
                    return false
                }
            }
            index = index + 1
        }
        return true
    }

    fn builtin_is_copy(builtin: Builtin) -> bool {
        let kind = builtin
        if builtin_is_scalar(kind) {
            return true
        }
        return kind == TextView() || kind == Arguments() || kind == RawPtr() || kind == Slice() || kind == Handle() || kind == RootToken()
    }

    fn type_is_concrete(value_type: Type) -> bool {
        match read value_type {
            ScopedFunction(inner) => {
                loan read inner as value {
                    return type_is_concrete(value)
                }
            }
            ParameterType(parameter) => {
                parameter;
                return false
            }
            Infer => {
                return false
            }
            Invalid => {
                return false
            }
            BuiltinType(builtin, arguments) => {
                builtin;
                return types_are_concrete(arguments)
            }
            NamedType(symbol, arguments) => {
                symbol;
                return types_are_concrete(arguments)
            }
            ArrayType(element, length) => {
                length;
                loan read element as value {
                    return type_is_concrete(value)
                }
            }
            FunctionType(parameters, result) => {
                return function_type_is_concrete(parameters, result)
            }
            _ => {
                return true
            }
        }
    }

    fn types_are_concrete(values: Vec<Type>) -> bool {
        var index: usize = 0
        while index < values.length() {
            loan read values[index] as value {
                if type_is_concrete(value) == false {
                    return false
                }
            }
            index = index + 1
        }
        return true
    }

    fn function_type_is_concrete(parameters: Vec<ParameterType>, result: Box<Type>) -> bool {
        var index: usize = 0
        while index < parameters.length() {
            loan read parameters[index] as parameter {
                if type_is_concrete(parameter.value_type) == false {
                    return false
                }
            }
            index = index + 1
        }
        loan read result as value {
            return type_is_concrete(value)
        }
    }

    fn builtin_copies_arguments(builtin: Builtin, count: usize) -> bool {
        let kind = builtin
        if kind != Option() && kind != Result() {
            return false
        }
        return count == builtin_type_arity(builtin)
    }
}
