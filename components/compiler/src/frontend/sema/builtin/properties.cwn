module sema {
    fn builtin_is_signed(builtin: Builtin) -> bool {
        match builtin {
            I8 | I16 | I32 | I64 | ISize => true
            _ => false
        }
    }

    fn builtin_is_integer(builtin: Builtin) -> bool {
        match builtin {
            U8 | U16 | U32 | U64 | USize => true
            _ => builtin_is_signed(builtin)
        }
    }

    fn builtin_is_float(builtin: Builtin) -> bool {
        builtin == F32() || builtin == F64()
    }

    fn builtin_is_numeric(builtin: Builtin) -> bool {
        builtin_is_integer(builtin) || builtin_is_float(builtin)
    }

    fn builtin_is_constant(builtin: Builtin) -> bool {
        builtin_is_numeric(builtin) || builtin == Bool() || builtin == Char()
    }

    fn builtin_is_scalar(builtin: Builtin) -> bool {
        builtin_is_constant(builtin) || builtin == Unit()
    }

    fn builtin_has_inline_payload(builtin: Builtin) -> bool {
        builtin == Option() || builtin == Result()
    }

    fn builtin_is_sequence(builtin: Builtin) -> bool {
        match builtin {
            Vec | Text | TextView | Arguments | Slice | RawPtr => true
            _ => false
        }
    }

    fn builtin_is_basic_container(builtin: Builtin) -> bool {
        builtin_is_sequence(builtin) || builtin == Thread() || builtin == Box()
    }

    fn builtin_width(builtin: Builtin) -> u32 {
        match builtin {
            I8 | U8 => 8
            I16 | U16 => 16
            I32 | U32 | F32 | Char => 32
            Bool => 1
            _ => 64
        }
    }
}
