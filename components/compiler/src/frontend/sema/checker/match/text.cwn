module sema {
    fn match_is_text(value_type: Type) -> bool {
        let kind = type_builtin(value_type)
        return kind == Text() || kind == TextView()
    }

    fn match_requires_move(symbols: Symbols, info: ExpressionInfo) -> bool {
        if type_builtin(info.value_type) == TextView() {
            return false
        }
        return type_is_copy_with_symbols(symbols, info.value_type) == false && value_is_owned(info.value) == false
    }

    fn checker_text_pattern(checker: write Checker, span: frontend::Span, context: write MatchContext) -> Option<Vec<Type>> {
        if match_is_text(context.value_type) == false {
            checker_error(checker, "text patterns require Text or TextView");
            return None()
        }
        let bytes = frontend::text_literal_bytes(checker.symbols.source, span)
        if text_pattern_seen(context.text_patterns, bytes) {
            checker_error(checker, "duplicate text pattern");
            return None()
        }
        context.text_patterns.push(move bytes)
        let literal = frontend::expression(frontend::ExpressionText(span), span)
        checker_expression(checker, literal)
        return Some(Vec<Type>.new())
    }

    fn text_pattern_seen(patterns: Vec<Vec<u8>>, value: Vec<u8>) -> bool {
        var index: usize = 0
        while index < patterns.length() {
            if frontend::literal_bytes_equal(patterns[index], value) {
                return true
            }
            index = index + 1
        }
        return false
    }
}
