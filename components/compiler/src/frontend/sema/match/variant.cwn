module sema {
    fn match_variant_count(checker: Checker, value_type: Type) -> usize {
        match read value_type {
            NamedType(symbol, arguments) => {
                arguments
                match read checker.symbols.types[symbol].kind {
                    Enum => {
                        return checker.symbols.types[symbol].variants.length()
                    }
                    _ => {
                        return 0
                    }
                }
            }
            BuiltinType(builtin, arguments) => {
                arguments
                let kind = builtin
                if kind == Option() || kind == Result() {
                    return 2
                }
                return 0
            }
            _ => {
                return 0
            }
        }
    }

    fn match_variant_fields(checker: Checker, value_type: Type, name: frontend::Name) -> Option<Vec<Type>> {
        match read value_type {
            NamedType(symbol, arguments) => {
                let query = VariantQuery {
                    symbol: symbol, arguments: types_copy(arguments), name: frontend::name_copy(name)
                }
                return named_variant_fields(checker, move query)
            }
            BuiltinType(builtin, arguments) => {
                let query = BuiltinVariantQuery {
                    builtin: builtin
                    arguments: types_copy(arguments)
                    name: frontend::name_copy(name)
                }
                return builtin_variant_fields(checker, move query)
            }
            _ => {
                return None()
            }
        }
    }

    struct VariantQuery {
        symbol: usize
        arguments: Vec<Type>
        name: frontend::Name
    }

    struct BuiltinVariantQuery {
        builtin: Builtin
        arguments: Vec<Type>
        name: frontend::Name
    }

    fn named_variant_fields(checker: Checker, query: take VariantQuery) -> Option<Vec<Type>> {
        var parameters = Vec<frontend::Name>.new()
        loan read checker.symbols.types[query.symbol] as declaration {
            parameters = names_copy(declaration.type_parameters)
        }
        let values = parameter_values(parameters, query.arguments)
        var index: usize = 0
        while index < checker.symbols.types[query.symbol].variants.length() {
            loan read checker.symbols.types[query.symbol].variants[index] as variant {
                if variant_name_matches(checker.symbols.source, variant.name, query.name) {
                    return Some(substitute_types(variant.fields, values))
                }
            }
            index = index + 1
        }
        return None()
    }

    fn builtin_variant_fields(checker: Checker, query: take BuiltinVariantQuery) -> Option<Vec<Type>> {
        let kind = query.builtin
        var fields = Vec<Type>.new()
        if kind == Option() && query.arguments.length() == 1 {
            if name_is(checker.symbols.source, query.name, "None") {
                return Some(move fields)
            }
            if name_is(checker.symbols.source, query.name, "Some") {
                loan read query.arguments[0] as value {
                    fields.push(type_copy(value))
                }
                return Some(move fields)
            }
        }
        if kind == Result() && query.arguments.length() == 2 {
            if name_is(checker.symbols.source, query.name, "Ok") {
                loan read query.arguments[0] as value {
                    fields.push(type_copy(value))
                }
                return Some(move fields)
            }
            if name_is(checker.symbols.source, query.name, "Err") {
                loan read query.arguments[1] as value {
                    fields.push(type_copy(value))
                }
                return Some(move fields)
            }
        }
        return None()
    }
}
