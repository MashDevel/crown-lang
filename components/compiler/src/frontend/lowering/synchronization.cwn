module lowering {
    fn initialize_lock(compiler: write FunctionCompiler, lock: usize) -> Result<void, u32> {
        return initialize_named_lock(compiler, "pthread_mutex_init", lock)
    }

    fn initialize_named_lock(compiler: write FunctionCompiler, name: take Text, lock: usize) -> Result<void, u32> {
        let null = ir::function_constant(compiler.ir, ir::TypePointer(), ir::ConstantNull())
        var arguments = Vec<usize>.new()
        arguments.push(lock)
        arguments.push(null)
        return synchronization_call(compiler, move name, move arguments)
    }

    fn call_lock(compiler: write FunctionCompiler, name: take Text, lock: usize) -> Result<void, u32> {
        var arguments = Vec<usize>.new()
        arguments.push(lock)
        return synchronization_call(compiler, move name, move arguments)
    }

    fn destroy_mutex(compiler: write FunctionCompiler, mutex: usize) -> Result<void, u32> {
        return call_lock(compiler, "pthread_mutex_destroy", mutex)
    }

    fn synchronization_call(compiler: write FunctionCompiler, name: take Text, arguments: take Vec<usize>) -> Result<void, u32> {
        var parameters = Vec<ir::Type>.new()
        for index in 0..arguments.length() {
            index
            parameters.push(ir::TypePointer())
        }
        let value_type = ir::TypeInteger(ir::IntegerWidth32())
        let result = function_imported_call(compiler, ImportedCall {
                name: move name, signature: ir::signature_new(move parameters, value_type), arguments: move arguments
            })?
        let status = match result {
            Some(value) => value
            None => {
                return Err(93)
            }
        }
        let zero = function_integer(compiler, value_type, 0)
        let succeeded = function_append_value(compiler, ir::InstructionCompare(ir::CompareEqual(), status, zero))?
        return function_guard_with(compiler, succeeded, "synchronization_failed")
    }
}
