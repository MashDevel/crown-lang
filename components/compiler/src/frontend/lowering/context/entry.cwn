module lowering {
    fn add_arguments_entry(compiler: write Compiler, main_function: usize) -> Result<void, u32> {
        var parameters = Vec<ir::Type>.new()
        parameters.push(ir::TypeInteger(ir::IntegerWidth64()))
        parameters.push(ir::TypePointer())
        let signature = ir::signature_new(move parameters, ir::TypeInteger(ir::IntegerWidth32()))
        var function = ir::function_new("crown_arguments_entry", move signature, ir::LinkageLocal())
        var block: usize = 0
        match ir::function_add_block(function) {
            Ok(value) => {
                block = value
            }
            Err(error) => {
                error;
                return Err(230)
            }
        }
        let arguments = entry_append_value(function, block, ir::InstructionStackSlot(16, 8))?
        entry_append(function, block, ir::InstructionStore(arguments, function.parameters[1], 8, false))?
        let offset_type = ir::TypeInteger(ir::IntegerWidth64())
        let offset_constant = ir::ConstantInteger(u64.from(8))
        let offset = ir::function_constant(function, offset_type, offset_constant)
        let length = entry_append_value(function, block, ir::InstructionOffset(arguments, offset))?
        entry_append(function, block, ir::InstructionStore(length, function.parameters[0], 8, false))?
        var values = Vec<usize>.new()
        values.push(arguments)
        let result = entry_append_value(function, block, ir::InstructionCall(main_function, move values, ir::TypeInteger(ir::IntegerWidth32())))?
        match ir::function_terminate(function, block, ir::TerminatorReturn(Some(result))) {
            Err(error) => {
                error;
                return Err(231)
            }
            Ok(value) => {
                value
            }
        }
        let entry = ir::program_add_function(compiler.output, move function)
        ir::program_set_entry(compiler.output, entry)
        return Ok(())
    }

    fn entry_append(function: write ir::Function, block: usize, kind: take ir::InstructionKind) -> Result<void, u32> {
        match ir::function_append(function, block, move kind) {
            Err(error) => {
                error;
                return Err(232)
            }
            Ok(value) => {
                value;
                return Ok(())
            }
        }
    }

    fn entry_append_value(function: write ir::Function, block: usize, kind: take ir::InstructionKind) -> Result<usize, u32> {
        match ir::function_append(function, block, move kind) {
            Err(error) => {
                error;
                return Err(233)
            }
            Ok(value) => {
                match value {
                    Some(id) => {
                        return Ok(id)
                    }
                    None => {
                        return Err(234)
                    }
                }
            }
        }
    }
}
