module lowering {
    fn static_owner(compiler: write FunctionCompiler, analysis: sema::Analysis, expression: frontend::Expression) -> Result<Value, u32> {
        match read expression.kind {
            frontend::ExpressionStaticCall(reference, method, arguments) => {
                reference
                if sema::name_is(analysis.checker.symbols.source, method, "new") == false || arguments.length() != 1 {
                    return Err(186)
                }
                let value_type = function_expression_type(compiler, analysis, expression)?
                return new_owned_value(compiler, analysis, move value_type, arguments[0])
            }
            _ => {
                return Err(187)
            }
        }
    }

    fn new_owned_value(compiler: write FunctionCompiler, analysis: sema::Analysis, value_type: take sema::Type, argument: frontend::Expression) -> Result<Value, u32> {
        let value = function_expression(compiler, analysis, argument)?
        if expression_terminated(compiler) {
            return Ok(VoidValue())
        }
        let element = owner_element(value_type)?
        let layout = layout(analysis.checker.symbols, element)?
        let size_type = ir::TypeInteger(ir::IntegerWidth64())
        let size = function_integer(compiler, size_type, layout.size)
        let data = function_allocate(compiler, size)?
        function_copy(compiler, analysis.checker.symbols, CopyRequest {
                destination: data, value: move value
            })?
        let allocation = OwnedAllocation {
            data: data, value_type: sema::type_copy(value_type)
        }
        if sema::type_builtin(value_type) == sema::Box() {
            return box_value(compiler, analysis.checker.symbols, allocation)
        }
        return shared_new_value(compiler, analysis.checker.symbols, allocation)
    }

    struct OwnedAllocation {
        data: usize
        value_type: sema::Type
    }

    fn box_value(compiler: write FunctionCompiler, symbols: sema::Symbols, allocation: OwnedAllocation) -> Result<Value, u32> {
        let address = function_stack(compiler, symbols, allocation.value_type)?
        function_store_pointer(compiler, address, allocation.data)?
        return Ok(AddressValue(address, sema::type_copy(allocation.value_type)))
    }

    fn shared_new_value(compiler: write FunctionCompiler, symbols: sema::Symbols, allocation: OwnedAllocation) -> Result<Value, u32> {
        let size_type = ir::TypeInteger(ir::IntegerWidth64())
        let size = function_integer(compiler, size_type, 72)
        let control = function_allocate(compiler, size)?
        let one_type = ir::TypeInteger(ir::IntegerWidth64())
        let one = function_integer(compiler, one_type, 1)
        let store = StoreRequest {
            address: control, value: one, value_type: sema::builtin_leaf(sema::USize())
        }
        function_store(compiler, symbols, store)?
        let mutex = function_offset(compiler, control, 8)?
        initialize_lock(compiler, mutex)?
        let request = SharedValue {
            data: allocation.data, control: control, value_type: sema::type_copy(allocation.value_type)
        }
        return shared_value(compiler, symbols, request)
    }

    struct SharedValue {
        data: usize
        control: usize
        value_type: sema::Type
    }

    fn shared_value(compiler: write FunctionCompiler, symbols: sema::Symbols, request: SharedValue) -> Result<Value, u32> {
        let address = function_stack(compiler, symbols, request.value_type)?
        function_store_pointer(compiler, address, request.data)?
        function_store_pointer_field(compiler, address, 8, request.control)?
        return Ok(AddressValue(address, sema::type_copy(request.value_type)))
    }

    fn shared_method(compiler: write FunctionCompiler, analysis: sema::Analysis, expression: frontend::Expression) -> Result<Value, u32> {
        match read expression.kind {
            frontend::ExpressionMethodCall(receiver, method, arguments) => {
                arguments
                if sema::name_is(analysis.checker.symbols.source, method, "share") == false {
                    return Err(189)
                }
                var source: usize = 0
                loan read receiver as value {
                    source = expression_place(compiler, analysis, value)?
                }
                return share_owned_value(compiler, analysis, source, expression)
            }
            _ => {
                return Err(190)
            }
        }
    }

    fn increment_shared(compiler: write FunctionCompiler, symbols: sema::Symbols, control: usize) -> Result<void, u32> {
        let mutex = function_offset(compiler, control, 8)?
        call_lock(compiler, "pthread_mutex_lock", mutex)?
        let request = Place {
            address: control, value_type: sema::builtin_leaf(sema::USize())
        }
        let references = function_load(compiler, symbols, request)?
        let one_type = ir::TypeInteger(ir::IntegerWidth64())
        let one = function_integer(compiler, one_type, 1)
        let operation = ScalarOperation {
            operator: frontend::BinaryAdd(), left: references, right: one, value_type: sema::builtin_leaf(sema::USize())
        }
        let next = integer_binary(compiler, symbols, operation)?
        let store = StoreRequest {
            address: control, value: next, value_type: sema::builtin_leaf(sema::USize())
        }
        function_store(compiler, symbols, store)?
        return call_lock(compiler, "pthread_mutex_unlock", mutex)
    }

    fn owner_element(value_type: sema::Type) -> Result<sema::Type, u32> {
        match read value_type {
            sema::BuiltinType(builtin, arguments) => {
                let kind = builtin
                if (kind != sema::Box() && kind != sema::Shared()) || arguments.length() != 1 {
                    return Err(192)
                }
                loan read arguments[0] as value {
                    return Ok(sema::type_copy(value))
                }
            }
            _ => {
                return Err(193)
            }
        }
    }
    fn share_owned_value(compiler: write FunctionCompiler, analysis: sema::Analysis, source: usize, expression: frontend::Expression) -> Result<Value, u32> {
        let data = function_load_pointer(compiler, source)?
        let control = function_load_pointer_field(compiler, source, 8)?
        increment_shared(compiler, analysis.checker.symbols, control)?
        let value_type = function_expression_type(compiler, analysis, expression)?
        let request = SharedValue {
            data: data, control: control, value_type: move value_type
        }
        return shared_value(compiler, analysis.checker.symbols, request)
    }

}
