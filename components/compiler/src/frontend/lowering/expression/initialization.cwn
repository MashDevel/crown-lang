module lowering {
    fn copy_expression_to(compiler: write FunctionCompiler, analysis: sema::Analysis, expression: frontend::Expression, destination: usize) -> Result<void, u32> {
        let value = function_expression(compiler, analysis, expression)?
        return function_copy(compiler, analysis.checker.symbols, CopyRequest {
                destination: destination, value: move value
            })
    }

    fn initialize_owned_place(compiler: write FunctionCompiler, analysis: sema::Analysis, expression: frontend::Expression, place: take Place) -> Result<void, u32> {
        copy_expression_to(compiler, analysis, expression, place.address)?
        stage_owned_place(compiler, analysis.checker.symbols, move place)
        return Ok(())
    }
}
