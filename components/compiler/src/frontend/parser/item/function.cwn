module frontend {
    fn parser_function(parser: write Parser) -> Function {
        let unsafe_value = parser_consumed(parser, TokenUnsafe())
        let start = parser_expect(parser, TokenFn())
        let name = parser_identifier(parser)
        let type_parameters = parser_type_parameters(parser)
        parser_expect(parser, TokenLeftParen())
        let parameters = parser_parameters(parser)
        parser_expect(parser, TokenArrow())
        let result = parser_type(parser)
        var body = parser_block(parser)
        parser_function_tail(body)
        let end = parser_previous_span(parser)
        return Function {
            name: move name
            unsafe_value: unsafe_value
            type_parameters: move type_parameters
            parameters: move parameters
            result: move result
            body: move body
            span: span_through(start.span, end)
        }
    }

    fn parser_resource(parser: write Parser) -> ResourceDecl {
        let transferable = parser_consumed(parser, TokenUnsafe())
        if transferable {
            let marker = parser_identifier(parser)
            if parser_name_is(parser, marker, "transferable") == false {
                parser_report(parser, UnexpectedToken())
            }
        }
        var opaque_value = false
        let first = parser_token_at(parser, parser.offset)
        var start = first.span
        if parser_consumed(parser, TokenOpaque()) {
            opaque_value = true
        }
        if transferable && opaque_value == false {
            parser_report(parser, UnexpectedToken())
        }
        let resource_token = parser_expect(parser, TokenResource())
        if opaque_value == false {
            start = resource_token.span
        }
        let name = parser_identifier(parser)
        let parameters = parser_type_parameters(parser)
        parser_expect(parser, TokenLeftBrace())
        parser_skip_breaks(parser)
        var fields = Vec<Field>.new()
        while parser_at(parser, TokenDrop()) == false && parser_at(parser, TokenEnd()) == false {
            fields.push(parser_field(parser))
            parser_field_end(parser)
        }
        parser_expect(parser, TokenDrop())
        let drop_body = parser_block(parser)
        parser_skip_breaks(parser)
        let end = parser_expect(parser, TokenRightBrace())
        return ResourceDecl {
            name: move name
            parameters: move parameters
            opaque_value: opaque_value
            transferable: transferable
            fields: move fields
            drop_body: move drop_body
            span: span_through(start, end.span)
        }
    }
}
