opaque resource NativeHandle {
    value: usize, drop {
        value
    }
}
fn main() -> u32 {
    let value = unsafe_value()
    let capture = Shared.new(move value)
    let worker = spawn move {
        capture
    }
    return 0
}
fn unsafe_value() -> NativeHandle {
    unsafe {
        return NativeHandle {
            value: 1
        }
    }
}
