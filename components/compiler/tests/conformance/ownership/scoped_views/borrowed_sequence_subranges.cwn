fn inspect(bytes: TextView) -> u32 {
    loan read bytes[1..4] as part {
        if part.length() != 3 || part[0] != 195 || part[1] != 169 || part[2] != 0 {
            return 1
        }
        loan read part[1..3] as nested {
            if nested.length() != 2 || nested[0] != 169 || nested[1] != 0 {
                return 2
            }
        }
    }
    loan read bytes[4..4] as empty {
        if empty.length() != 0 {
            return 3
        }
    }
    return 0
}

fn mutate(values: write Slice<u32>) -> void {
    loan write values[1..3] as part {
        part[0] = 42;
        part[1] = 43
    }
}

fn main() -> u32 {
    let text = "xé\0"
    loan read text as bytes {
        let result = inspect(bytes);
        if result != 0 {
            return result
        }
    }
    var values = [1, 2, 3, 4]
    loan write values as view {
        mutate(view)
    }
    if values[0] != 1 || values[1] != 42 || values[2] != 43 || values[3] != 4 {
        return 4
    }
    return 0
}
