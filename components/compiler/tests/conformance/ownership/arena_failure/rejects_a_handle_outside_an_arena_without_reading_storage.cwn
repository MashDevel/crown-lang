struct Item {
    value: u32
}
fn main() -> u32 {
    var source = Arena<Item>.new()
    let foreign = source.insert(Item {
            value: 7
        })
    var target = Arena<Item>.new()
    let local = target.insert(Item {
            value: 9
        })
    if target.contains(foreign) {
        target.with(foreign) as read item {
            return item.value + 20
        }
    }
    match target.remove(foreign) {
        Some(item) => {
            return item.value + 30
        }
        None => {
        }
    }
    target.with(local) as read item {
        return item.value
    }
    return 0
}
