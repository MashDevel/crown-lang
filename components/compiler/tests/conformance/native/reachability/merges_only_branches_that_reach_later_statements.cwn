struct Item {
    value: u32
}
fn consume(item: take Item) -> u32 {
    return item.value
}
fn choose(condition: read bool, item: take Item) -> u32 {
    if condition {
        return consume(move item)
    } else {
        print(0)
    }
    return consume(move item)
}
fn main() -> u32 {
    return choose(false, Item {
            value: 7
        })
}
