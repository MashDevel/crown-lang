fn first() -> [u8; 7] {
    return [1, 2, 3, 4, 5, 6, 7]
}
fn second() -> [u8; 7] {
    return [1, 2, 3, 4, 5, 6, 7]
}
fn main(arguments: Arguments) -> u32 {
    let make: fn() -> [u8; 7] = if arguments.length() == 0 {
        first
    } else {
        second
    }
    let bytes = make()
    for index in 0..7 {
        if bytes[index] != u8.from(index + 1) {
            return 1
        }
    }
    return 42
}
