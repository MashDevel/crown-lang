extern "c" {
    fn create(output: RawPtr<usize>, entry: usize, environment: usize, base: usize, length: usize) -> i32 = "crown_pthread_create_stack"
}

fn main() -> u32 {
    var output: [usize; 1] = [91]
    unsafe {
        let address = output.as_raw()
        if create(RawPtr<usize>.from_address(0), 1, 0, 16, 16384) != 22 {
            return 1
        }
        if create(address, 0, 0, 16, 16384) != 22 {
            return 2
        }
        if create(address, 1, 0, 0, 16384) != 22 {
            return 3
        }
        if create(address, 1, 0, 17, 16384) != 22 {
            return 4
        }
        if create(address, 1, 0, 16, 16383) != 22 {
            return 5
        }
        if create(address, 1, 0, 18446744073709551600, 16384) != 22 {
            return 6
        }
    }
    return if output[0] == 91 {
        0
    } else {
        7
    }
}
