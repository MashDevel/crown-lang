extern "c" {
    fn parse(input: RawPtr<u8>, end: write RawPtr<u8>) -> f64 = "strtod"
}

fn main() -> u32 {
    let input: Text = "11x\0"
    unsafe {
        var end = RawPtr<u8>.from_address(0)
        let result = parse(input.as_raw(), end)
        if result != 11.0 || end != input.as_raw().offset(2) {
            return 1
        }
        if end.read_volatile() != 120 {
            return 2
        }
        return 11
    }
}
