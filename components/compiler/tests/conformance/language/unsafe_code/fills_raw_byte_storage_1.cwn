fn main() -> u32 {
    var values = Vec<u8>.new()
    values.push(0)
    values.push(0)
    values.push(0)
    unsafe {
        values.as_raw().fill(7, 3)
        values.as_raw().fill(9, 0)
    }
    if values[0] != 7 {
        return 1
    }
    if values[1] != 7 {
        return 2
    }
    if values[2] != 7 {
        return 3
    }
    return 0
}
