copy struct Callback<T> {
    call: fn(read T) -> u32
}
fn length(text: Text) -> u32 {
    return u32.from(text.length())
}
fn main() -> u32 {
    let original = Callback<Text> {
        call: length
    }
    let copied = original
    let first = original.call
    let second = copied.call
    if first("abc") != 3 || second("x") != 1 {
        return 1
    }
    return 0
}
