copy struct Point {
    x: u32, y: f64
}
copy enum Choice {
    Empty, Point(Point), Number(u64)
}
fn update(value: write Point) -> Point {
    value.x = 9;
    return value
}
fn main() -> u32 {
    let a = Point {
        x: 2, y: 3.0
    }
    let b = Point {
        x: 2, y: 4.0
    }
    if a != a || a == b {
        return 1
    }
    let left = Choice::Point(a)
    if left != Choice::Point(a) || left == Choice::Point(b) || left == Choice::Number(2) {
        return 2
    }
    let xs: [Point; 2] = [a, b]
    let ys: [Point; 2] = [a, a]
    if xs != xs || xs == ys {
        return 3
    }
    let some: Option<Point> = Some(a)
    let none: Option<Point> = None()
    if some != Some(a) || some == none || none != none {
        return 4
    }
    let ok: Result<Point, u32> = Ok(a)
    let error: Result<Point, u32> = Err(7)
    if ok != Ok(a) || ok == error || error != Err(7) {
        return 5
    }
    let zero = Point {
        x: 0, y: -0.0
    }
    if zero !=(Point {
            x: 0, y: 0.0
        }) {
        return 6
    }
    let nan = Point {
        x: 0, y: f64.from_bits(0x7ff8000000000000)
    }
    if nan == nan {
        return 7
    }
    var current = a
    if current == update(current) {
        return 8
    }
    return 0
}
