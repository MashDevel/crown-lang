const HIGH: u64 = 0xffff_ffff_ffff_ffff
copy enum Direction {
    Left, Right, Up
}
enum Message {
    First(Text), Second(Text)
}
fn horizontal(value: Direction) -> bool {
    match value {
        Left | Right => true,
        Up => false
    }
}
fn integer(value: u64) -> u32 {
    match value {
        0 | 1 => 1,
        HIGH => 2,
        _ => 3
    }
}
fn signed(value: i8) -> u32 {
    match value {
        -128 | -1 => 1,
        0 => 2,
        _ => 3
    }
}
fn text(value: TextView) -> u32 {
    match value {
        "a" | "é" => 1,
        _ => 2
    }
}
fn size(value: take Message) -> usize {
    match move value {
        First(text) | Second(text) => text.length()
    }
}
fn directions() -> u32 {
    if horizontal(Direction::Left()) == false || horizontal(Direction::Right()) == false || horizontal(Direction::Up()) {
        return 1
    }
    return 0
}
fn integers() -> u32 {
    if integer(0) != 1 || integer(1) != 1 || integer(HIGH) != 2 || integer(2) != 3 {
        return 2
    }
    if signed(-128) != 1 || signed(-1) != 1 || signed(0) != 2 || signed(127) != 3 {
        return 3
    }
    return 0
}
fn messages() -> u32 {
    let value = "é"
    loan read value as view {
        if text(view) != 1 {
            return 4
        }
    }
    if size(First("hello")) != 5 || size(Second("λ")) != 2 {
        return 5
    }
    return 0
}
fn main() -> u32 {
    let direction = directions()
    if direction != 0 {
        return direction
    }
    let integer = integers()
    if integer != 0 {
        return integer
    }
    return messages()
}
