module guest {
    extern "c" {
        fn raw_startup(version: u16, data: RawPtr<u8>) -> i32 = "WSAStartup"
        fn raw_cleanup() -> i32 = "WSACleanup"
        fn raw_socket(domain: i32, kind: i32, protocol: i32) -> u64 = "socket"
        fn raw_connect(socket: u64, address: RawPtr<u8>, length: i32) -> i32 = "connect"
        fn raw_recv(socket: u64, data: RawPtr<u8>, length: i32, flags: i32) -> i32 = "recv"
        fn raw_send(socket: u64, data: RawPtr<u8>, length: i32, flags: i32) -> i32 = "send"
        fn raw_option(socket: u64, level: i32, name: i32, value: RawPtr<u32>, length: i32) -> i32 = "setsockopt"
        fn raw_close(socket: u64) -> i32 = "closesocket"
    }

    fn socket_startup() -> Result<void, Text> {
        var data = std::bytes::filled(408, 0)
        unsafe {
            if raw_startup(514, data.as_raw()) != 0 {
                return Err("could not initialize guest sockets")
            }
        }
        return Ok(())
    }

    fn native_socket_create() -> Result<u64, Text> {
        socket_startup()?
        unsafe {
            let descriptor = raw_socket(1, 1, 0)
            if descriptor == 18446744073709551615 {
                raw_cleanup();
                return Err("could not create guest socket")
            }
            return Ok(descriptor)
        }
    }

    fn native_socket_close(descriptor: u64) -> void {
        unsafe {
            if descriptor != 18446744073709551615 {
                raw_close(descriptor);
                raw_cleanup();
            }
        }
    }

    fn native_socket_connect(descriptor: u64, address: Vec<u8>) -> i32 {
        unsafe {
            return raw_connect(descriptor, address.as_raw(), i32.from(address.length()))
        }
    }

    fn socket_count(length: usize) -> i32 {
        if length > 2147483647 {
            return 2147483647
        }
        return i32.from(length)
    }

    unsafe fn native_socket_send(descriptor: u64, data: RawPtr<u8>, length: usize) -> isize {
        unsafe {
            return isize.from(raw_send(descriptor, data, socket_count(length), 0))
        }
    }

    unsafe fn native_socket_receive(descriptor: u64, data: RawPtr<u8>, length: usize) -> isize {
        unsafe {
            return isize.from(raw_recv(descriptor, data, socket_count(length), 0))
        }
    }

    fn native_socket_timeout(descriptor: u64) -> Result<void, Text> {
        var timeout = Vec<u32>.new()
        timeout.push(30000)
        unsafe {
            if raw_option(descriptor, 65535, 4102, timeout.as_raw(), 4) != 0 {
                return Err("could not set guest receive timeout")
            }
            if raw_option(descriptor, 65535, 4101, timeout.as_raw(), 4) != 0 {
                return Err("could not set guest send timeout")
            }
        }
        return Ok(())
    }

    fn socket_address(path: Text) -> Result<Vec<u8>, Text> {
        var address = socket_path(path, 110)?
        address[0] = 1
        return Ok(move address)
    }
}
