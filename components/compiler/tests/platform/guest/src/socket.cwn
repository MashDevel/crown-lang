module guest {
    opaque resource Socket {
        descriptor: u64
        buffer: Vec<u8>
        position: usize
        length: usize
        drop {
            unsafe {
                native_socket_close(descriptor)
            }
        }
    }

    fn connect(path: Text) -> Result<Socket, Text> {
        let address = socket_address(path)?
        unsafe {
            let descriptor = native_socket_create()?
            let socket = Socket {
                descriptor: descriptor, buffer: std::bytes::filled(4096, 0), position: 0, length: 0
            }
            socket_timeout(socket)?
            if native_socket_connect(descriptor, address) != 0 {
                return Err("could not connect to guest socket")
            }
            return Ok(move socket)
        }
    }

    fn socket_timeout(socket: Socket) -> Result<void, Text> {
        unsafe {
            return native_socket_timeout(socket.descriptor)
        }
    }

    fn send(socket: Socket, message: Text) -> Result<void, Text> {
        var offset: usize = 0
        while offset < message.length() {
            unsafe {
                let count = native_socket_send(socket.descriptor, message.as_raw().offset(offset), message.length() - offset)
                if count <= 0 {
                    return Err("could not send guest request")
                }
                offset = offset + usize.from(count)
            }
        }
        return Ok(())
    }

    fn receive_byte(socket: write Socket) -> Result<u8, Text> {
        unsafe {
            if socket.position == socket.length {
                unsafe {
                    let count = native_socket_receive(socket.descriptor, socket.buffer.as_raw(), socket.buffer.length())
                    if count <= 0 {
                        return Err("guest socket closed or timed out")
                    }
                    socket.length = usize.from(count)
                    socket.position = 0
                }
            }
            let byte = socket.buffer[socket.position]
            socket.position = socket.position + 1
            return Ok(byte)
        }
    }

    fn exchange(socket: write Socket, message: Text) -> Result<Text, Text> {
        send(socket, message)?
        var bytes = Vec<u8>.new()
        while true {
            let byte = receive_byte(socket)?
            if byte == 10 {
                return std::text::from_bytes(bytes)
            }
            bytes.push(byte)
        }
        return Err("unterminated guest response")
    }

    fn socket_path(path: Text, length: usize) -> Result<Vec<u8>, Text> {
        if path.length() == 0 || path.length() + 3 > length {
            return Err("invalid guest socket path length")
        }
        toolchain::cstring(path)?
        var output = std::bytes::filled(length, 0)
        loan read path as bytes {
            for index in 0..bytes.length() {
                output[index + 2] = bytes[index]
            }
        }
        return Ok(move output)
    }
}
