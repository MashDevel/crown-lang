module guest {
    fn socket_tests() -> Result<void, Text> {
        testing::error(socket_address(""))?
        testing::error(socket_address(std::text::repeat("x", 108)))?
        testing::error(socket_address("a\0b"))?
        testing::error(connect("/nonexistent/crown-guest.sock"))?
        return socket_pair_test()
    }

    fn socket_responses(client: write Socket, server: write Socket) -> Result<void, Text> {
        unsafe {
            socket_timeout(client)?
            send(server, "{\"return\":1}\n{\"return\":2}\n")?
            testing::expect(std::text::equal(exchange(client, "request\n")?, "{\"return\":1}"), "socket response")?
            testing::expect(std::text::equal(exchange(client, "request\n")?, "{\"return\":2}"), "buffered response")?
            unsafe {
                native_socket_close(server.descriptor);
                server.descriptor = 18446744073709551615
            }
            testing::error(send(client, "closed\n"))?
            return testing::error(receive_byte(client))
        }
    }
}
