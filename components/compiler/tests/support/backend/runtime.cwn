fn safety_execute(program: take ir::Program) -> Result<void, u32> {
    if toolchain::host_target().architecture == toolchain::Architecture::Arm64() {
        let object = match arm64::codegen(move program, safety_arm_variant()) {
            Ok(value) => move value
            Err(error) => {
                toolchain::failure(error);
                return Err(74)
            }
        }
        return safety_execute_object(move object)
    }
    let object = match x86::codegen(move program) {
        Ok(value) => move value
        Err(error) => {
            error;
            return Err(74)
        }
    }
    return safety_execute_object(move object)
}

fn safety_execute_object(object: take object::CompilerObject) -> Result<void, u32> {
    match safety_run_object(move object) {
        Ok(value) => {
            value;
            return Ok(())
        }
        Err(error) => {
            toolchain::failure(error);
            return Err(73)
        }
    }
}

fn safety_run_object(object: take object::CompilerObject) -> Result<void, Text> {
    let temporary = toolchain::temporary(toolchain::temporary_directory())?
    let directory = toolchain::temporary_path(temporary)
    let path = toolchain::path_join(directory, "program")
    let bytes = safety_executable(move object)?
    toolchain::write_bytes(path, bytes)?
    toolchain::executable(path)?
    var command = Vec<Text>.new()
    command.push(path.clone())
    return toolchain::require_command(move command)
}

fn safety_executable(input: take object::CompilerObject) -> Result<Vec<u8>, Text> {
    var object = move input
    if toolchain::host_target().platform == toolchain::Platform::Linux() {
        var options = elf::Options {
            interpreter: elf::interpreter(toolchain::read_bytes("/proc/self/exe")?)?,
            libraries: elf::libraries(Vec<Text>.new())?, versions: Vec<elf::SymbolVersion>.new()
        }
        elf::startup_import(object)?;
        options.versions = elf::resolve_versions(object, options)?
        return elf::executable(move object, options)
    }
    return macho::executable(object, macho::libraries(Vec<Text>.new())?)
}

fn safety_arm_variant() -> arm64::AbiVariant {
    return if toolchain::host_target().platform == toolchain::Platform::Macos() {
        arm64::AbiVariant::Darwin()
    } else {
        arm64::AbiVariant::Aapcs64()
    }
}
