fn main() -> u32 {
    let signature = ir::signature_new(Vec<ir::Type>.new(), ir::TypeVoid())
    var function = ir::function_new("flow", move signature, ir::LinkageLocal())
    let empty = ir::dominators(function)
    if empty.count != 0 || ir::dominates(empty, 0, 0) { return 1 }
    var index: usize = 0
    while index < 7 { function.blocks.push(ir::basic_block_new()); index = index + 1 }
    function.blocks[0].terminator = Some(ir::TerminatorBranch(5))
    function.blocks[5].terminator = Some(ir::TerminatorConditional(0, 3, 4))
    function.blocks[3].terminator = Some(ir::TerminatorBranch(1))
    function.blocks[4].terminator = Some(ir::TerminatorBranch(1))
    function.blocks[1].terminator = Some(ir::TerminatorConditional(0, 5, 2))
    function.blocks[2].terminator = Some(ir::TerminatorReturn(None()))
    function.blocks[6].terminator = Some(ir::TerminatorBranch(6))
    let order = ir::all_reverse_postorder(function)
    if order.length() != 7 || order[0] != 0 || order[6] != 6 { return 9 }
    var seen = optimize::false_values(7)
    index = 0
    while index < order.length() {
        if seen[order[index]] { return 10 }
        seen[order[index]] = true
        index = index + 1
    }
    let dominators = ir::dominators(function)
    index = 0
    while index < 6 {
        if ir::dominates(dominators, index, 0) == false || ir::dominates(dominators, index, index) == false { return 2 }
        index = index + 1
    }
    if ir::dominates(dominators, 1, 3) || ir::dominates(dominators, 1, 4) { return 3 }
    if ir::dominates(dominators, 2, 1) == false || ir::dominates(dominators, 1, 5) == false { return 4 }
    if ir::dominates(dominators, 5, 1) || ir::dominates(dominators, 7, 0) { return 5 }
    let children = optimize::gvn_dominator_children(function)
    if children[0].length() != 1 || children[0][0] != 5 { return 6 }
    let loops = optimize::blocks_in_loops(function)
    if loops[0] || loops[2] || loops[6] { return 7 }
    if loops[1] == false || loops[3] == false || loops[4] == false || loops[5] == false { return 8 }
    return 42
}
