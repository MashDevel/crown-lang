fn pair(values: read Slice<u32>) -> u32 {
    return values[0] + values[1]
}

fn main() -> u32 {
    var values = [1, 2, 3, 4]
    var result = 0
    loan write values[1..3] as middle {
        middle[0] = 20
        middle[1] = 22
        result = pair(middle)
    }
    print(values[1])
    return result
}
