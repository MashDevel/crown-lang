enum ExampleError {
    Missing
}

fn increment(value: read u32) -> Result<u32, ExampleError> {
    if value == 0 {
        return Err(Missing())
    }
    return Ok(value + 1)
}

fn compute() -> Result<u32, ExampleError> {
    let first = increment(40)?
    return increment(first)
}

fn main() -> u32 {
    let outcome = compute()
    match move outcome {
        Ok(value) => { return value }
        Err(error) => {
            error
            return 0
        }
    }
}
