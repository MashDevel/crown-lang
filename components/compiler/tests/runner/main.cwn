fn main(arguments: Arguments) -> u32 {
    let values = toolchain::arguments(arguments)
    match run_tests(values) {
        Ok(status) => status
        Err(error) => {
            toolchain::failure(error);
            1
        }
    }
}

fn run_tests(arguments: Vec<Text>) -> Result<u32, Text> {
    toolchain::set_environment("CROWN_JOBS", "1")?
    if arguments.length() > 1 && std::text::equal(arguments[1], "_case") {
        return harness::run_case_worker(arguments)
    }
    let options = toolchain::parse_options(arguments)?
    let environment = test_environment(options)?
    if std::text::equal(options.command, "release") {
        toolchain::set_environment("CROWN_JOBS", std::text::decimal(u64.from(options.jobs)))?
        return campaign::run(campaign::Release {
                environment: move environment, seed: options.seed
            })
    }
    let registry = toolchain::path_join(environment.root, "components/compiler/tests/cases.json")
    let request = harness::Suite {
        executable: toolchain::absolute(arguments[0])?, environment: move environment, registry: move registry, jobs: options.jobs, filter: options.filter.clone()
    }
    return harness::run_suite(move request)
}

fn test_environment(options: toolchain::Options) -> Result<harness::Environment, Text> {
    if options.paths.length() != 1 {
        return Err("test runner requires one compiler path")
    }
    toolchain::set_environment("CROWN_TEST_COMPILER", toolchain::absolute(options.paths[0])?)?
    let root = toolchain::repository_root()?
    let output = if options.output.length() == 0 {
        toolchain::path_join(root, std::text::joined("target/", options.command))
    } else {
        toolchain::absolute(options.output)?
    }
    return Ok(harness::Environment {
            coverage: options.coverage.clone(),
            compiler: toolchain::absolute(options.paths[0])?, root: root.clone(), output: move output
        })
}
