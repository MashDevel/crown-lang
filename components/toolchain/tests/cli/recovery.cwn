fn recover(root: Text) -> Result<void, Text> {
    let cache = toolchain::path_join(root, "bootstrap")
    let expected = missing_compiler(root, cache)?
    corrupt_compiler(root, cache, expected)?
    return stale_compiler(root, cache, expected)
}

fn missing_compiler(root: Text, cache: Text) -> Result<Text, Text> {
    let missing = testing_recovery::launcher(root, cache)?
    testing::expect(missing.status == 0 && std::text::contains(missing.stdout, "crown 0.1.0"), std::text::joined("missing-binary recovery: ", missing.stderr))?
    let expected = testing_recovery::current_digest(root)?
    let binary = toolchain::path_join(cache, toolchain::executable_name("crown", toolchain::host_target()))
    testing::expect(std::text::equal(toolchain::digest(binary)?, expected), "recovery compiler matches the current checkout")?
    return Ok(move expected)
}

fn corrupt_compiler(root: Text, cache: Text, expected: Text) -> Result<void, Text> {
    let binary = toolchain::path_join(cache, toolchain::executable_name("crown", toolchain::host_target()))
    toolchain::write_text(binary, "corrupted executable")?
    let corrupt = testing_recovery::launcher(root, cache)?
    testing::expect(corrupt.status == 0 && std::text::contains(corrupt.stdout, "crown 0.1.0"), "corrupt-binary recovery")?
    return testing::expect(std::text::equal(toolchain::digest(binary)?, expected), "recovered executable bytes")
}

fn stale_compiler(root: Text, cache: Text, expected: Text) -> Result<void, Text> {
    let binary = toolchain::path_join(cache, toolchain::executable_name("crown", toolchain::host_target()))
    forge_stale(binary)?
    let stale = testing_recovery::launcher(root, cache)?
    testing::expect(stale.status == 0 && std::text::contains(stale.stdout, "crown 0.1.0"), "intact stale compiler recovery")?
    testing::expect(std::text::equal(toolchain::digest(binary)?, expected), "stale compiler replaced by the current checkout compiler")?
    return recorded_lineage(binary)
}

fn forge_stale(binary: Text) -> Result<void, Text> {
    let program = testing::status_program(toolchain::parent_path(binary), "stale", 91)?
    toolchain::copy_file(program, binary)?
    toolchain::executable(binary)?
    toolchain::record_build(binary, toolchain::digest_text("previous sources")?, Some(toolchain::digest_text("previous seed")?))?
    return Ok(())
}

fn recorded_lineage(binary: Text) -> Result<void, Text> {
    let seed = toolchain::path_join(toolchain::repository_root()?, toolchain::seed_relative("compiler.s"))
    let record = toolchain::json(toolchain::read_text(std::text::joined(binary, ".crown-build"))?)?
    let expected = toolchain::json_text(record, toolchain::json_required(record, record.root, "seed")?)?
    return testing::expect(std::text::equal(toolchain::digest(seed)?, expected), "cache records current seed")
}

fn run() -> Result<void, Text> {
    let temporary = toolchain::temporary(toolchain::temporary_directory())?
    let root = toolchain::temporary_path(temporary)
    testing_recovery::host_selection(root)?
    recover(root)?
    return Ok(())
}

fn main() -> u32 {
    return testing::done(run())
}
