fn number(document: toolchain::Json, object: usize, field: Text) -> Result<u64, Text> {
    return toolchain::json_integer(document, toolchain::json_required(document, object, field)?)
}

fn metrics(root: Text) -> Result<void, Text> {
    let path = testing::write_file(root, "good.cwn", "fn main() -> u32 {\n    if true {\n        return 0\n    }\n    return 1\n}\n")?
    let report = toolchain::path_join(root, "report.json")
    testing::clean_call(root, std::text::joined(std::text::joined("lint|", path), std::text::joined("|--output|", report)))?
    let document = toolchain::json(toolchain::read_text(report)?)?
    let functions = toolchain::json_array_values(document, toolchain::json_required(document, document.root, "functions")?)?
    testing::expect(functions.length() == 1, "one function")?
    return function_metrics(document, functions[0])
}

fn metric(document: toolchain::Json, function: usize, field: Text, expected: u64) -> Result<void, Text> {
    return testing::expect(number(document, function, field)? == expected, field)
}

fn function_metrics(document: toolchain::Json, function: usize) -> Result<void, Text> {
    metric(document, function, "lines", 6)?
    metric(document, function, "parameters", 0)?
    metric(document, function, "cyclomatic", 2)?
    metric(document, function, "cognitive", 1)?
    return metric(document, function, "nesting", 1)
}

fn limits(root: Text) -> Result<void, Text> {
    let path = testing::write_file(root, "long.cwn", std::text::joined(std::text::joined("fn main() -> u32 {\n", std::text::repeat("    0\n", 60)), "    return 0\n}\n"))?
    testing::failed_call(root, std::text::joined("lint|", path))?
    toolchain::write_text(path, "fn main() -> u32 { return missing }")?
    let invalid = testing::failed_call(root, std::text::joined("lint|", path))?
    testing::expect(std::text::contains(invalid.stderr, "unknown name"), "lint includes semantic errors")?
    return Ok(())
}

fn run() -> Result<void, Text> {
    let temporary = toolchain::temporary(toolchain::temporary_directory())?
    let root = toolchain::temporary_path(temporary)
    metrics(root)?
    limits(root)?
    return Ok(())
}

fn main() -> u32 {
    return testing::done(run())
}
