fn verify(root: Text, source: Text, expected: Text) -> Result<void, Text> {
    let path = testing::write_file(root, "blocks.cwn", source)?
    checking(root, path, source)?
    apply(root, path, expected)?
    return testing::clean_call(root, std::text::joined("run|", path))
}

fn checking(root: Text, path: Text, source: Text) -> Result<void, Text> {
    let command = std::text::joined("fmt|--check|", path)
    let pending = testing::invoke(testing::list(command), root)?
    testing::expect(pending.status == 1, "inline blocks fail format checking")?
    return testing::expect(std::text::equal(toolchain::read_text(path)?, source), "checking preserves source")
}

fn apply(root: Text, path: Text, expected: Text) -> Result<void, Text> {
    let command = std::text::joined("fmt|", path)
    let formatted = testing::invoke(testing::list(command), root)?
    testing::expect(formatted.status == 0, std::text::joined("block formatting: ", formatted.stderr))?
    let actual = toolchain::read_text(path)?
    testing::expect(std::text::equal(actual, expected), std::text::joined("block layout: ", actual))?
    return testing::clean_call(root, std::text::joined(command, "|--check"))
}

fn loops(root: Text) -> Result<void, Text> {
    let source = "fn main()->u32 {var n:u32=0; while n < 2 {if n == 0 {n = n + 1} else {n = n + 1}} for i in 0..1 {i; n = n + 1} if n == 3 {return 0} return 1}"
    let expected = "fn main() -> u32 {\n    var n: u32 = 0;\n    while n < 2 {\n        if n == 0 {\n            n = n + 1\n        } else {\n            n = n + 1\n        }\n    }\n    for i in 0..1 {\n        i;\n        n = n + 1\n    }\n    if n == 3 {\n        return 0\n    }\n    return 1\n}\n"
    return verify(root, source, expected)
}

fn expressions(root: Text) -> Result<void, Text> {
    let source = "const ENABLED:bool=true\nstruct Data {value:u32}\nfn main()->u32 {let n = if ENABLED {Data {value:2}} else if false {Data {value:1}} else {Data {value:0}}; return match n.value {2 => 0, _ => 1}}"
    let expected = "const ENABLED: bool = true\nstruct Data {\n    value: u32\n}\nfn main() -> u32 {\n    let n = if ENABLED {\n        Data {\n            value: 2\n        }\n    } else if false {\n        Data {\n            value: 1\n        }\n    } else {\n        Data {\n            value: 0\n        }\n    };\n    return match n.value {\n        2 => 0,\n        _ => 1\n    }\n}\n"
    return verify(root, source, expected)
}

fn scope_and_literals(root: Text) -> Result<void, Text> {
    let source = "module values {fn zero()->u32 {return 0}} fn main()->u32 {let text=\"if { ; } while\\n\"; let a=[1,2]; text; a; unsafe {} while false {} return values::zero()}"
    let expected = "module values {\n    fn zero() -> u32 {\n        return 0\n    }\n}\nfn main() -> u32 {\n    let text = \"if { ; } while\\n\";\n    let a = [1, 2];\n    text;\n    a;\n    unsafe {\n    }\n    while false {\n    }\n    return values::zero()\n}\n"
    return verify(root, source, expected)
}

fn adjacent_arms(root: Text) -> Result<void, Text> {
    let source = "fn main()->u32 {match 0 {0 => {return 0} _ => {return 1}}}"
    let expected = "fn main() -> u32 {\n    match 0 {\n        0 => {\n            return 0\n        }\n        _ => {\n            return 1\n        }\n    }\n}\n"
    return verify(root, source, expected)
}

fn syntax_failure(root: Text) -> Result<void, Text> {
    let source = "fn main() -> u32 { if { return 0 } }"
    let path = testing::write_file(root, "broken.cwn", source)?
    testing::failed_call(root, std::text::joined("fmt|", path))?
    return testing::expect(std::text::equal(toolchain::read_text(path)?, source), "syntax failure preserves input")
}

fn array_types(root: Text) -> Result<void, Text> {
    let source = "fn first(value:[u32;2])->u32 {return value[0]}\nfn main()->u32 {let values:[[u32;2];1]=[[0,1]]; let empty:[u8;0]=[]; empty; (values[0][1]); return first(values[0])}"
    let expected = "fn first(value: [u32; 2]) -> u32 {\n    return value[0]\n}\nfn main() -> u32 {\n    let values: [[u32; 2]; 1] = [[0, 1]];\n    let empty: [u8; 0] = [];\n    empty;\n    (values[0][1]);\n    return first(values[0])\n}\n"
    return verify(root, source, expected)
}

fn convenience(root: Text) -> Result<void, Text> {
    let source = "fn main()->u32 {var n:u32=1;n+=1;if !false {n<<=1}return n - 4}"
    let expected = "fn main() -> u32 {\n    var n: u32 = 1;\n    n += 1;\n    if !false {\n        n <<= 1\n    }\n    return n - 4\n}\n"
    return verify(root, source, expected)
}

fn pattern_value(root: Text) -> Result<void, Text> {
    let source = "fn main()->u32 {let n=if let None=Some(1){2}else{0};return n}"
    let expected = "fn main() -> u32 {\n    let n = if let None = Some(1) {\n        2\n    } else {\n        0\n    };\n    return n\n}\n"
    return verify(root, source, expected)
}

fn run() -> Result<void, Text> {
    let temporary = toolchain::temporary(toolchain::temporary_directory())?
    let root = toolchain::temporary_path(temporary)
    loops(root)?
    expressions(root)?
    scope_and_literals(root)?
    adjacent_arms(root)?
    array_types(root)?
    convenience(root)?
    pattern_value(root)?
    return syntax_failure(root)
}

fn main() -> u32 {
    return testing::done(run())
}
