fn repeated(count: usize, byte: u8, expected: Text) -> Result<void, Text> {
    let bytes = std::bytes::filled(count, byte)
    return testing::expect(std::text::equal(toolchain::digest_bytes(bytes)?, expected), "portable SHA-256 vector")
}

fn padding_vectors() -> Result<void, Text> {
    repeated(0, 97, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")?
    repeated(1, 97, "ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb")?
    repeated(55, 97, "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318")?
    repeated(56, 97, "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a")?
    repeated(63, 97, "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34")?
    repeated(64, 97, "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb")?
    return Ok(())
}

fn block_vectors() -> Result<void, Text> {
    repeated(65, 97, "635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0")?
    repeated(127, 97, "c57e9278af78fa3cab38667bef4ce29d783787a2f731d4e12200270f0c32320a")?
    repeated(128, 97, "6836cf13bac400e9105071cd6af47084dfacad4e5e302c94bfed24e013afb73e")?
    repeated(129, 97, "c12cb024a2e5551cca0e08fce8f1c5e314555cc3fef6329ee994a3db752166ae")?
    repeated(1000, 97, "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3")?
    repeated(1000000, 97, "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")?
    return Ok(())
}

fn binary_vectors() -> Result<void, Text> {
    repeated(65, 0, "98ce42deef51d40269d542f5314bef2c7468d401ad5d85168bfab4c0108f75f7")?
    repeated(65, 255, "855c9a28fff2bbbd71327165554a00c6fdd44d5d58c1f12b8fdff29b5d67f001")?
    testing::expect(std::text::equal(toolchain::digest_text("abc")?, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"), "SHA-256 abc")?
    return testing::expect(std::text::equal(toolchain::digest_text("é λ")?, "3afc9a5b15f9c51be0d01be47cff306557d8d0c42c7058fe1120eb780a72ecda"), "SHA-256 UTF-8")
}

fn run() -> Result<void, Text> {
    padding_vectors()?
    block_vectors()?
    return binary_vectors()
}

fn main() -> u32 {
    return testing::done(run())
}
