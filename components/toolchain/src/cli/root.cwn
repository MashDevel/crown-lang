module toolchain {
    fn configure_toolchain(program: Text) -> Result<void, Text> {
        let configured = environment("CROWN_ROOT")
        if configured.length() != 0 {
            return Ok(())
        }
        var directory = parent_path(resolve_program(program)?)
        while true {
            if is_directory(path_join(directory, "components/library/src")) {
                return set_environment("CROWN_ROOT", directory)
            }
            let parent = parent_path(directory)
            if std::text::equal(parent, directory) {
                return Ok(())
            }
            directory = parent.clone()
        }
    }

    fn resolve_program(program: Text) -> Result<Text, Text> {
        if program_has_path(program) {
            return absolute(program)
        }
        let names = program_candidates(program)
        let directories = std::text::split(environment("PATH"), path_list_separator())
        for index in 0..directories.length() {
            for name in 0..names.length() {
                let candidate = path_join(directories[index], names[name])
                if executable_file(candidate)? {
                    return absolute(candidate)
                }
            }
        }
        return absolute(program)
    }

}
