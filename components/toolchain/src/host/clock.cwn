module toolchain {
    fn wait_briefly() -> void {
        wait_interval(1)
    }

    fn wait_milliseconds(duration: u64) -> void {
        let started = milliseconds()
        var elapsed: u64 = 0
        while elapsed < duration {
            let remaining = duration - elapsed
            let interval: u32 = if remaining > 999 {
                999
            } else {
                u32.from(remaining)
            }
            wait_interval(interval)
            elapsed = milliseconds() - started
        }
    }
}
