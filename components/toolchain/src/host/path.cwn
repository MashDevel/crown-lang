module toolchain {
    fn path_join(parent: Text, child: Text) -> Text {
        if path_root_length(child) != 0 || parent.length() == 0 {
            return child.clone()
        }
        loan read parent as bytes {
            if path_separator(bytes[bytes.length() - 1]) {
                return std::text::joined(parent, child)
            }
        }
        return std::text::joined(std::text::joined(parent, "/"), child)
    }

    fn parent_path(path: Text) -> Text {
        let root = path_root_length(path)
        var end = path.length()
        loan read path as bytes {
            while end > root && path_separator(bytes[end - 1]) {
                end = end - 1
            }
            while end > root {
                end = end - 1
                if path_separator(bytes[end]) {
                    break
                }
            }
        }
        if end == 0 {
            return "."
        }
        return std::text::slice(path, 0, end)
    }

    fn file_name(path: Text) -> Text {
        var start = path.length()
        loan read path as bytes {
            while start > 0 && path_separator(bytes[start - 1]) == false {
                start = start - 1
            }
        }
        return std::text::slice(path, start, path.length())
    }

    fn below(path: Text, directory: Text) -> bool {
        return std::text::equal(path, directory) || std::text::starts(path, path_join(directory, ""))
    }
}
