module toolchain {
    extern "c" {
        fn raw_attributes_init(attributes: RawPtr<RawPtr<u8>>) -> i32 = "posix_spawnattr_init"
        fn raw_attributes_destroy(attributes: RawPtr<RawPtr<u8>>) -> i32 = "posix_spawnattr_destroy"
        fn raw_attributes_flags(attributes: RawPtr<RawPtr<u8>>, flags: i16) -> i32 = "posix_spawnattr_setflags"
        fn raw_attributes_group(attributes: RawPtr<RawPtr<u8>>, group: i32) -> i32 = "posix_spawnattr_setpgroup"
    }

    opaque resource SpawnAttributes {
        private handle: Vec<RawPtr<u8>>
        drop {
            unsafe {
                raw_attributes_destroy(handle.as_raw())
            }
        }
    }

    fn spawn_attributes() -> Result<SpawnAttributes, Text> {
        var handle = Vec<RawPtr<u8>>.new()
        for index in 0..SPAWN_ATTRIBUTE_WORDS {
            index;
            handle.push(null())
        }
        unsafe {
            if raw_attributes_init(handle.as_raw()) != 0 {
                return Err("could not initialize process attributes")
            }
            let attributes = SpawnAttributes {
                handle: move handle
            }
            if raw_attributes_flags(attributes.handle.as_raw(), 2) != 0 {
                return Err("could not set process flags")
            }
            if raw_attributes_group(attributes.handle.as_raw(), 0) != 0 {
                return Err("could not set process group")
            }
            return Ok(move attributes)
        }
    }
}
