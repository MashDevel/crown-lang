module toolchain {
    extern "c" {
        fn raw_spawn(pid: RawPtr<i32>, path: RawPtr<u8>, actions: RawPtr<RawPtr<u8>>, attributes: RawPtr<RawPtr<u8>>, arguments: RawPtr<RawPtr<u8>>, environment: RawPtr<RawPtr<u8>>) -> i32 = "posix_spawnp"
        fn raw_actions_init(actions: RawPtr<RawPtr<u8>>) -> i32 = "posix_spawn_file_actions_init"
        fn raw_actions_destroy(actions: RawPtr<RawPtr<u8>>) -> i32 = "posix_spawn_file_actions_destroy"
        fn raw_waitpid(pid: i32, status: RawPtr<i32>, options: i32) -> i32 = "waitpid"
        fn raw_kill(pid: i32, signal: i32) -> i32 = "kill"
    }

    opaque resource SpawnActions {
        private handle: Vec<RawPtr<u8>>
        drop {
            unsafe {
                raw_actions_destroy(handle.as_raw())
            }
        }
    }

    fn spawn_actions() -> Result<SpawnActions, Text> {
        var handle = Vec<RawPtr<u8>>.new()
        for index in 0..SPAWN_ACTION_WORDS {
            index;
            handle.push(null())
        }
        unsafe {
            if raw_actions_init(handle.as_raw()) != 0 {
                return Err("could not prepare process file actions")
            }
            return Ok(SpawnActions {
                    handle: move handle
                })
        }
    }

    fn redirect(actions: write SpawnActions, descriptor: i32, path: Text) -> Result<void, Text> {
        if path.length() == 0 {
            return Ok(())
        }
        let encoded = cstring(path)?
        unsafe {
            if raw_actions_open(actions.handle.as_raw(), descriptor, std::cstr::as_raw(encoded), OUTPUT_OPEN_FLAGS, 384) != 0 {
                return Err(std::text::joined("could not redirect process output: ", path))
            }
        }
        return Ok(())
    }

    fn spawn_process(arguments: Vec<Text>, actions: SpawnActions) -> Result<i32, Text> {
        if arguments.length() == 0 {
            return Err("cannot start an empty command")
        }
        var encoded = Vec<std::cstr::CString>.new()
        for index in 0..arguments.length() {
            encoded.push(cstring(arguments[index])?)
        }
        var pointers = Vec<RawPtr<u8>>.new()
        unsafe {
            for index in 0..encoded.length() {
                pointers.push(std::cstr::as_raw(encoded[index]))
            }
        }
        pointers.push(null())
        var pid = Vec<i32>.new()
        pid.push(0)
        let attributes = spawn_attributes()?
        unsafe {
            let status = raw_spawn(pid.as_raw(), pointers[0], actions.handle.as_raw(), attributes.handle.as_raw(), pointers.as_raw(), process_environment())
            if status != 0 {
                return Err(std::text::joined("cannot start: ", arguments[0]))
            }
        }
        return Ok(pid[0])
    }

    fn wait_process(pid: i32, timeout: u64) -> Result<i32, Text> {
        let started = milliseconds()
        var status = process_status_slot()
        while true {
            match poll_process(pid, status)? {
                Some(value) => {
                    return Ok(value)
                }
                None => {
                }
            }
            if deadline_reached(started, timeout) {
                unsafe {
                    terminate_process(pid, status)
                }
                return Err("process timed out")
            }
            wait_briefly()
        }
        return Err("could not wait for process")
    }

    fn process_status_slot() -> Vec<i32> {
        var status = Vec<i32>.new()
        status.push(0)
        return move status
    }

    fn poll_process(pid: i32, status: write Vec<i32>) -> Result<Option<i32>, Text> {
        unsafe {
            let result = raw_waitpid(pid, status.as_raw(), 1)
            if result == pid {
                return Ok(Some(process_status(status[0])))
            }
            if result == 0 ||(result < 0 && raw_errno().read() == 4) {
                return Ok(None())
            }
        }
        return Err("could not wait for process")
    }

    fn deadline_reached(started: u64, timeout: u64) -> bool {
        return timeout != 0 && milliseconds() - started >= timeout
    }

    unsafe fn terminate_process(pid: i32, status: write Vec<i32>) -> void {
        unsafe {
            raw_kill(-pid, 9);
            raw_kill(pid, 9);
            raw_waitpid(pid, status.as_raw(), 0)
        }
    }

    fn process_status(status: i32) -> i32 {
        let signal = status & 127
        if signal != 0 {
            return -signal
        }
        return (status >> 8) & 255
    }
}
